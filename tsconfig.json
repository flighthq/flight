{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true, // Allow emitting files during build
    "outDir": "dist", // Output directory for build
    "declaration": true, // Generate .d.ts files for distribution
    "declarationMap": true, // Generate declaration maps for debugging
    "sourceMap": true // Generate source maps for JS files
  },
  "include": [
    "conformance/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/src/**/*.test.ts", // Include test files here
    "packages/**/src/**/*.spec.ts",
    "packages/**/__tests__/**/*.ts",
    "examples/**/src/**/*.ts",
    "scripts/**/*.ts",
    // A scripts test covers this source-analysis helper, which lives in the review tool. Only the helper
    // is listed: the rest of tools/review is browser code whose DOM types this project does not carry.
    "tools/review/src/sourceExpectedDescription.ts"
  ],
  "exclude": ["node_modules", "dist", ".claude", "examples/runners"]
}
