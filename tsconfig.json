{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true, // Allow emitting files during build
    "outDir": "dist", // Output directory for build
    "declaration": true, // Generate .d.ts files for distribution
    "declarationMap": true, // Generate declaration maps for debugging
    "sourceMap": true // Generate source maps for JS files
  },
  "include": [
    "conformance/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/src/**/*.test.ts", // Include test files here
    "packages/**/src/**/*.spec.ts",
    "packages/**/__tests__/**/*.ts",
    "examples/**/src/**/*.ts",
    "scripts/**/*.ts",
    // Scripts tests cover these pure helpers from the review tool. Only the helpers are listed: the rest
    // of tools/review is browser code whose DOM types this project does not carry.
    "tools/review/src/sourceExpectedDescription.ts",
    "tools/review/src/cellRole.ts",
    "tools/review/src/commissionEligibility.ts",
    "tools/review/src/commissionState.ts",
    "tools/review/src/holdLedger.ts",
    "tools/review/src/referenceImageCommission.ts",
    "tools/review/src/reviewFilter.ts",
    "tools/review/src/reviewOrder.ts"
  ],
  "exclude": ["node_modules", "dist", ".claude", "examples/runners"]
}
