{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../input" },
    { "path": "../node/tsconfig.runtime.json" },
    { "path": "../signals" },
    { "path": "../text/tsconfig.runtime.json" },
    { "path": "../textformat" },
    { "path": "../textlayout/tsconfig.runtime.json" },
    { "path": "../textsegment" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.textinput-types.ts", "src/types.ts"]
}
