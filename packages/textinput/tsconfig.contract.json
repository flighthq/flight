{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".text-types", ".textlayout-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../input" },
    { "path": "../signals" },
    { "path": "../text/tsconfig.contract.json" },
    { "path": "../textlayout/tsconfig.contract.json" }
  ],
  "include": ["src/contract.textinput-types.ts", "src/types.ts"]
}
