{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".geometry-types", ".texture-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.contract.json" },
    { "path": "../materials/tsconfig.runtime.json" },
    { "path": "../texture/tsconfig.contract.json" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.shading-types.ts", "src/types/**/*.ts"]
}
