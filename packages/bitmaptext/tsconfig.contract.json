{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".geometry-types",
      ".glyphatlas-types",
      ".node-types",
      ".scene2d-types",
      ".texture-types",
      ".textureatlas-bridge-types",
      ".textureatlas-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../glyphatlas/tsconfig.contract.json"
    },
    {
      "path": "../scene2d/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
      "path": "../textureatlas/tsconfig.contract.json"
    },
    {
      "path": "../types/tsconfig.textureatlas-bridge-types.json"
    }
  ],
  "include": ["src/contract.bitmaptext-types.ts", "src/types.ts"]
}
