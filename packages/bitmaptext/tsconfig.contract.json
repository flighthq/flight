{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".bitmaptext-bridge-types",
      ".geometry-types",
      ".glyphatlas-types",
      ".node-types",
      ".scene2d-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../geometry/tsconfig.contract.json" },
    { "path": "../glyphatlas/tsconfig.contract.json" },
    { "path": "../scene2d/tsconfig.contract.json" },
    { "path": "../types/tsconfig.bitmaptext-bridge-types.json" }
  ],
  "include": ["src/contract.bitmaptext-types.ts", "src/types.ts"]
}
