{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../bitmap/tsconfig.contract.json" },
    { "path": "../entity" },
    { "path": "../font/tsconfig.contract.json" },
    { "path": "../geometry/tsconfig.runtime.json" },
    { "path": "../glyphatlas/tsconfig.runtime.json" },
    { "path": "../image/tsconfig.contract.json" },
    { "path": "../log" },
    { "path": "../node/tsconfig.runtime.json" },
    { "path": "../scene2d/tsconfig.runtime.json" },
    { "path": "../texture/tsconfig.runtime.json" },
    { "path": "../textureatlas" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.bitmaptext-types.ts", "src/types.ts"]
}
