{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".adjustments-types",
      ".audio-types",
      ".effects-types",
      ".font-types",
      ".image-types",
      ".path-types",
      ".scene2d-types",
      ".shape-types",
      ".swf-bridge-types",
      ".text-types",
      ".texture-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../adjustments/tsconfig.contract.json"
    },
    {
      "path": "../audio/tsconfig.contract.json"
    },
    {
      "path": "../compression"
    },
    {
      "path": "../effects/tsconfig.contract.json"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../font/tsconfig.contract.json"
    },
    {
      "path": "../image/tsconfig.contract.json"
    },
    {
      "path": "../importdiagnostics"
    },
    {
      "path": "../path/tsconfig.contract.json"
    },
    {
      "path": "../scene2d/tsconfig.contract.json"
    },
    {
      "path": "../shape/tsconfig.contract.json"
    },
    {
      "path": "../text/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
      "path": "../types/tsconfig.swf-bridge-types.json"
    }
  ],
  "include": ["src/contract.swf-types.ts", "src/types/**/*.ts"]
}
