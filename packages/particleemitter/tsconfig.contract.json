{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".geometry-types",
      ".particles-types",
      ".scene2d-types",
      ".scene3d-types",
      ".textureatlas-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../geometry/tsconfig.contract.json" },
    { "path": "../particles/tsconfig.contract.json" },
    { "path": "../scene2d/tsconfig.contract.json" },
    { "path": "../scene3d/tsconfig.contract.json" },
    { "path": "../textureatlas/tsconfig.contract.json" }
  ],
  "include": ["src/contract.particleemitter-types.ts", "src/types.ts"]
}
