{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.runtime.json"
    },
    {
      "path": "../node/tsconfig.runtime.json"
    },
    {
      "path": "../scene2d/tsconfig.runtime.json"
    },
    {
      "path": "./tsconfig.contract.json"
    }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/contract.velocity-types.ts",
    "src/velocity2D.ts",
    "src/velocityExplanation.ts",
    "src/velocitySample.ts",
    "src/velocityStore.ts"
  ]
}
