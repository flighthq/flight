    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".bitmap-types", ".geometry-types", ".shape-types", ".surface-types", ".texture-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.render-state-bridge-types"
  },
  "references": [
