{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["@webgpu/types"],
    "moduleSuffixes": [".app-types", ".surface-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.surface-bridge-types"
  },
  "references": [
    { "path": "../app/tsconfig.contract.json" },
    { "path": "../entity" },
    { "path": "../surface/tsconfig.contract.json" }
  ],
  "include": [
    "src/contract.surface-bridge-types.ts",
    "src/WgpuHost.render-wgpu-types.ts",
    "src/WgpuSurface.surface-bridge-types.ts"
  ]
}
