    "@flighthq/flow": "*",
    "@flighthq/font": "*",
    "@flighthq/geolocation": "*",
    "@flighthq/geometry": "*",
    "@flighthq/gui": "*",
    "@flighthq/haptics": "*",
    "@flighthq/host": "*",
    "@flighthq/image": "*",
    "@flighthq/image-codec": "*",
    "@flighthq/importdiagnostics": "*",
    "@flighthq/input": "*",
    "@flighthq/interaction": "*",
    "@flighthq/keyboard": "*",
    "@flighthq/layout": "*",
    "@flighthq/lifecycle": "*",
    "@flighthq/log": "*",
    "@flighthq/materials": "*",
