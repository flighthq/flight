    {
      "path": "../scene3d/tsconfig.node.json"
    },
    {
      "path": "../shading/tsconfig.contract.json"
    }
  ],
  "include": [
    "src/contract.render-wgpu-bridge-types.ts",
    "src/contract.render-backend-bridge-types.ts",
    "src/*.render-wgpu-types.ts",
    "src/*.scene2d-wgpu-bridge-types.ts",
