      ".adjustments-types",
      ".app-types",
      ".geometry-types",
      ".surface-types",
      ".scene2d-wgpu-bridge-types",
      ".shape-types",
      ".velocity-types",
      ".image-types",
      ".platform-types",
      ".lighting-types",
      ".scene3d-node-types",
      ""
    ],
    "types": ["@webgpu/types"],
    "tsBuildInfoFile": "dist/.tsbuildinfo.render-wgpu-types"
  },
  "references": [
    {
      "path": "../meshgeometry/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
