{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".shading-types",
      ".meshgeometry-types",
      ".render-gl-types",
      ".render-wgpu-bridge-types",
      ".render-types",
      ".texture-types",
      ".bitmap-types",
      ".camera-types",
      ".node-types",
      ".materials-types",
      ".scene3d-gl-bridge-types",
      ".render-wgpu-types",
