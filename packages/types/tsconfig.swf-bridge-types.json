  "files": [
    "src/AdvancedBlendMode.ts",
    "src/BlendMode.materials-types.ts",
    "src/Entity.ts",
    "src/FrameScript.ts",
    "src/ImageResourceReference.ts",
    "src/Node2D.scene2d-types.ts",
    "src/Scene2DDocument.ts",
    "src/Timeline.ts",
    "src/TimelineCue.ts",
    "src/TimelineFrameEvent.ts",
    "src/TimelineLabel.ts",
