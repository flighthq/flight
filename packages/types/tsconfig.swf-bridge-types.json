{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".audio-types", ".image-types", ".materials-types", ".scene2d-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.swf-bridge-types"
  },
  "references": [
