{
  "name": "@flighthq/render",
  "version": "0.5.0",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight.git",
    "directory": "packages/render"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.test.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "generate": "tsx ../../scripts/generate-rust-package.ts --crate flight-render --package render",
    "generate:check": "tsx ../../scripts/generate-rust-package.ts --crate flight-render --package render --check",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --watch --config vitest.config.ts",
    "prepack": "npm run clean && npm run clean:dist && npm run build",
    "clean:dist": "tsx ../../scripts/clean-package-dist.ts"
  },
  "dependencies": {
    "@flighthq/adjustments": "*",
    "@flighthq/camera": "*",
    "@flighthq/color": "*",
    "@flighthq/entity": "*",
    "@flighthq/geometry": "*",
    "@flighthq/image": "*",
    "@flighthq/lighting": "*",
    "@flighthq/log": "*",
    "@flighthq/materials": "*",
    "@flighthq/meshgeometry": "*",
    "@flighthq/node": "*",
    "@flighthq/path": "*",
    "@flighthq/registry": "*",
    "@flighthq/requirement": "*",
    "@flighthq/scene2d": "*",
    "@flighthq/scene3d": "*",
    "@flighthq/shape": "*",
    "@flighthq/signals": "*",
    "@flighthq/surface": "*",
    "@flighthq/texture": "*",
    "@flighthq/types": "*"
  },
  "devDependencies": {
    "@flighthq/lighting": "*",
    "@flighthq/scene3d": "*",
    "@flighthq/quadbatch": "*",
    "@flighthq/tilemap": "*",
    "typescript": "^7.0.2"
  },
  "description": "Renderer registration, render state, render queue, and backend draw contracts",
  "sideEffects": false
}
