{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract",
    "moduleSuffixes": [
      ".meshgeometry-types",
      ".materials-types",
      ".adjustments-types",
      ".geometry-types",
      ".texture-types",
      ""
    ]
  },
  "references": [
    {
      "path": "../adjustments/tsconfig.contract.json"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../meshgeometry/tsconfig.contract.json"
    },
    {
      "path": "../signals"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
      "path": "../requirement"
    }
  ],
  "include": ["src/contract.render-types.ts", "src/types.ts"]
}
