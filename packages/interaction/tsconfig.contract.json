{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".node-types", ".geometry-types", ".path-types", ".spatial-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.contract.json" },
    { "path": "../input" },
    { "path": "../node/tsconfig.contract.json" },
    { "path": "../path/tsconfig.contract.json" },
    { "path": "../signals" },
    { "path": "../spatial/tsconfig.contract.json" }
  ],
  "include": ["src/contract.interaction-types.ts", "src/types/**/*.ts"]
}
