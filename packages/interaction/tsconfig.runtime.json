    },
    {
      "path": "../shape/tsconfig.runtime.json"
    },
    {
      "path": "../signals"
    },
    {
      "path": "../spatial/tsconfig.runtime.json"
    },
    {
      "path": "../quadbatch/tsconfig.runtime.json"
