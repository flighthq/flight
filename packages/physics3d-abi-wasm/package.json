{
  "name": "@flighthq/physics3d-abi-wasm",
  "version": "0.5.0",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight.git",
    "directory": "packages/physics3d-abi-wasm"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/flight-physics3d-abi-wasm --target web --out-dir ../../packages/physics3d-abi-wasm/src/wasm --out-name physics3d_abi_wasm",
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@flighthq/physics3d-abi": "*",
    "@flighthq/types": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "description": "Wasm-backed drop-in replacement for @flighthq/physics3d-abi",
  "sideEffects": false
}
