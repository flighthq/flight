{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".meshgeometry-bridge-types", ".geometry-types", ".materials-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.contract.json" },
    { "path": "../materials/tsconfig.contract.json" },
    { "path": "../signals" },
    { "path": "../types/tsconfig.meshgeometry-types.json" }
  ],
  "include": ["src/contract.meshgeometry-types.ts", "src/types/**/*.ts"]
}
