{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".geometry-types",
      ".materials-types",
      ".scene3d-node-types",
      ".adjustments-types",
      ".node-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../signals"
    },
    {
      "path": "../scene3d/tsconfig.node.json"
    },
    {
      "path": "../node/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.meshgeometry-types.ts", "src/types/**/*.ts"]
}
