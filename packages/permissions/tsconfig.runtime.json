{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".midi-types", ".notification-types", ".preferences-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../geolocation"
    },
    {
      "path": "../midi/tsconfig.contract.json"
    },
    {
      "path": "../notification/tsconfig.contract.json"
    },
    {
      "path": "../preferences/tsconfig.contract.json"
    },
    {
      "path": "./tsconfig.contract.json"
    }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.permissions-types.ts", "src/types.ts"]
}
