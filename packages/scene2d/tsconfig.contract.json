{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".node-types", ".materials-types", ".geometry-types", ".clip-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../clip/tsconfig.contract.json" },
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.contract.json" },
    { "path": "../layout" },
    { "path": "../materials/tsconfig.contract.json" },
    { "path": "../node/tsconfig.contract.json" },
    { "path": "../signals" }
  ],
  "include": ["src/contract.scene2d-types.ts", "src/types/**/*.ts"]
}
