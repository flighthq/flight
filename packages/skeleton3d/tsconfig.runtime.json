{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["@testing-library/jest-dom", "vitest/globals", "@webgpu/types"],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.runtime.json" },
    { "path": "../log" },
    { "path": "../meshgeometry/tsconfig.runtime.json" },
    { "path": "../node/tsconfig.runtime.json" },
    { "path": "../scene3d/tsconfig.runtime.json" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.skeleton3d-types.ts", "src/Skeleton3DValidationDiagnostic.ts"]
}
