{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "moduleSuffixes": [
      ".render-types",
      ".scene2d-wgpu-bridge-types",
      ".materials-types",
      ".render-wgpu-types",
      ".image-types",
      ".node-types",
      ".surface-types",
      ".text-types",
      ".textlayout-types",
      ".lighting-types",
      ".geometry-types",
      ".texture-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../image/tsconfig.contract.json"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../node/tsconfig.contract.json"
    },
    {
      "path": "../render-wgpu/tsconfig.contract.json"
    },
    {
      "path": "../surface/tsconfig.contract.json"
    },
    {
      "path": "../text/tsconfig.contract.json"
    },
    {
      "path": "../textlayout/tsconfig.contract.json"
    },
    {
      "path": "../types/tsconfig.scene2d-wgpu-types.json"
    },
    {
      "path": "../render/tsconfig.contract.json"
    },
    {
      "path": "../lighting/tsconfig.contract.json"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.scene2d-wgpu-types.ts", "src/types/**/*.ts"]
}
