{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".effects-canvas-bridge-types",
      ".scene2d-canvas-types",
      ".effects-types",
      ".adjustments-types",
      ".surface-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../adjustments/tsconfig.contract.json" },
    { "path": "../effects/tsconfig.contract.json" },
    { "path": "../entity" },
    { "path": "../scene2d-canvas/tsconfig.contract.json" },
    { "path": "../surface/tsconfig.contract.json" },
    { "path": "../types/tsconfig.effects-canvas-bridge-types.json" }
  ],
  "include": ["src/contract.effects-canvas-types.ts", "src/types.ts"]
}
