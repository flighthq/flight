{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".scene2d-types",
      ".texture-types",
      ".node-types",
      ".materials-types",
      ".clip-types",
      ".geometry-types",
      ".path-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../adjustments/tsconfig.contract.json"
    },
    {
      "path": "../clip/tsconfig.contract.json"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../layout"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../node/tsconfig.contract.json"
    },
    {
      "path": "../path/tsconfig.contract.json"
    },
    {
      "path": "../scene2d/tsconfig.contract.json"
    },
    {
      "path": "../signals"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
      "path": "../types/tsconfig.materials-types.json"
    }
  ],
  "include": ["src/contract.shape-types.ts", "src/types/**/*.ts"]
}
