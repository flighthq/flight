{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    {
      "path": "../texture/tsconfig.runtime.json"
    },
    {
      "path": "../animation"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.runtime.json"
    },
    {
      "path": "../log"
    },
    {
      "path": "../math"
    },
    {
      "path": "../node/tsconfig.runtime.json"
    },
    {
      "path": "../path/tsconfig.runtime.json"
    },
    {
      "path": "../scene2d/tsconfig.runtime.json"
    },
    {
      "path": "./tsconfig.contract.json"
    }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.shape-types.ts", "src/types/**/*.ts"]
}
