    "src/types.ts",
    "src/LibgdxParticleSchema.ts",
    "src/ParticleConfigIssue.ts",
    "src/ParticleConfigParse.ts",
    "src/ParticleDesignerSchema.ts",
    "src/ParticleFormatCodec.ts",
    "src/ParticleFormatDescriptor.ts",
    "src/ParticleFormatKind.ts",
    "src/ParticleFormatWarning.ts",
    "src/ParticleSerializeResult.ts",
    "src/PixiParseResult.ts",
    "src/SpineParticleSchema.ts",
    "src/StarlingPexSchema.ts",
    "src/UnitySchema.ts"
