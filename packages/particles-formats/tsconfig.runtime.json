{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../importdiagnostics" },
    { "path": "../math" },
    { "path": "../particles" },
    { "path": "../requirement" },
    { "path": "../types" },
    { "path": "./tsconfig.contract.json" }
