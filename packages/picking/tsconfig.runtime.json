{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".materials-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../camera/tsconfig.runtime.json" },
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.runtime.json" },
    { "path": "../materials/tsconfig.contract.json" },
    { "path": "../meshgeometry/tsconfig.runtime.json" },
    { "path": "../node/tsconfig.runtime.json" },
    { "path": "../scene3d" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.picking-types.ts", "src/types.ts"]
}
