{
  "name": "@flighthq/scene2d-resources",
  "version": "0.6.0",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight.git",
    "directory": "packages/scene2d-resources"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.test.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "generate": "tsx ../../scripts/generate-rust-package.ts --crate flight-scene2d-resources --package scene2d-resources",
    "generate:check": "tsx ../../scripts/generate-rust-package.ts --crate flight-scene2d-resources --package scene2d-resources --check",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --watch --config vitest.config.ts",
    "prepack": "npm run clean && npm run clean:dist && npm run build",
    "clean:dist": "tsx ../../scripts/clean-package-dist.ts"
  },
  "dependencies": {
    "@flighthq/audio": "*",
    "@flighthq/entity": "*",
    "@flighthq/image": "*",
    "@flighthq/image-codec": "*",
    "@flighthq/importdiagnostics": "*",
    "@flighthq/log": "*",
    "@flighthq/node": "*",
    "@flighthq/path-boolean": "*",
    "@flighthq/resource": "*",
    "@flighthq/scene2d": "*",
    "@flighthq/scene2d-formats": "*",
    "@flighthq/signals": "*",
    "@flighthq/texture": "*"
  },
  "devDependencies": {
    "@flighthq/path-boolean": "*",
    "@flighthq/scene2d": "*",
    "typescript": "^7.0.2"
  },
  "description": "Renderer-neutral Scene2D documents with explicit application slot and image resource resolution",
  "sideEffects": false
}
