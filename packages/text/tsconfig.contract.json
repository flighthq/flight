{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".textformat-types",
      ".textlayout-types",
      ".textshaper-types",
      ".scene2d-types",
      ".node-types",
      ".materials-types",
      ".geometry-types",
      ".clip-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../scene2d/tsconfig.contract.json"
    },
    {
      "path": "../signals"
    },
    {
      "path": "../textformat/tsconfig.contract.json"
    },
    {
      "path": "../textlayout/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.text-types.ts", "src/types.ts"]
}
