{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract",
    "moduleSuffixes": [".app-types", ".bitmap-types", ".geometry-types", ".surface-types", ".texture-types", ""]
  },
  "references": [
    {
      "path": "../app/tsconfig.contract.json"
    },
    {
      "path": "../bitmap/tsconfig.contract.json"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../image-codec"
    },
    {
      "path": "../resource"
    },
    {
      "path": "../surface/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.image-types.ts", "src/types.ts"]
}
