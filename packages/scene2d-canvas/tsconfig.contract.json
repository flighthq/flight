{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".effects-canvas-bridge-types",
      ".bitmap-types",
      ".materials-types",
      ".render-types",
      ".surface-types",
      ".texture-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../bitmap/tsconfig.contract.json" },
    { "path": "../entity" },
    { "path": "../materials/tsconfig.contract.json" },
    { "path": "../render/tsconfig.contract.json" },
    { "path": "../surface/tsconfig.contract.json" },
    { "path": "../texture/tsconfig.contract.json" },
    { "path": "../types/tsconfig.effects-canvas-bridge-types.json" }
  ],
  "include": ["src/contract.scene2d-canvas-types.ts", "src/types/**/*.ts"]
}
