{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".meshgeometry-types",
      ".render-types",
      ".camera-types",
      ".scene3d-gl-types",
      ".materials-types",
      ".render-gl-types",
      ".geometry-types",
      ".texture-types",
      ".render-wgpu-types",
      ".lighting-types",
      ".scene3d-node-types",
      ".node-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../camera/tsconfig.contract.json"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../meshgeometry/tsconfig.contract.json"
    },
    {
      "path": "../render-gl/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
      "path": "../render/tsconfig.contract.json"
    },
    {
      "path": "../lighting/tsconfig.contract.json"
    },
    {
      "path": "../scene3d/tsconfig.node.json"
    },
    {
      "path": "../node/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.scene3d-gl-types.ts", "src/types/**/*.ts"]
}
