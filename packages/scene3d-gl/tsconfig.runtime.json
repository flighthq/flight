{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../camera/tsconfig.runtime.json" },
    { "path": "../color" },
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.runtime.json" },
    { "path": "../image/tsconfig.runtime.json" },
    { "path": "../lighting/tsconfig.runtime.json" },
    { "path": "../log" },
    { "path": "../materials/tsconfig.runtime.json" },
    { "path": "../meshgeometry/tsconfig.runtime.json" },
    { "path": "../node/tsconfig.runtime.json" },
    { "path": "../particleemitter" },
    { "path": "../particles" },
    { "path": "../registry" },
    { "path": "../render/tsconfig.runtime.json" },
    { "path": "../render-gl" },
    { "path": "../scene2d-gl" },
    { "path": "../scene3d" },
    { "path": "../shading" },
    { "path": "../skeleton3d" },
    { "path": "../texture/tsconfig.runtime.json" },
    { "path": "../textureatlas/tsconfig.runtime.json" },
    { "path": "../types" },
    { "path": "../video" },
    { "path": "./tsconfig.contract.json" }
