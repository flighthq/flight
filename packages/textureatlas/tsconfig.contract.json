{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".geometry-types", ".texture-types", ".textureatlas-bridge-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
      "path": "../types/tsconfig.textureatlas-bridge-types.json"
    }
  ],
  "include": ["src/contract.textureatlas-types.ts", "src/types.ts"]
}
