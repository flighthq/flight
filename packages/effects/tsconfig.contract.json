{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".effects-bridge-types", ".render-types", ".texture-types", ".geometry-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../render/tsconfig.contract.json" },
    { "path": "../texture/tsconfig.contract.json" },
    { "path": "../types/tsconfig.effects-bridge-types.json" }
  ],
  "include": ["src/contract.effects-types.ts", "src/types.ts", "src/types/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
