{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".render-types",
      ".app-types",
      ".geometry-types",
      ".path-types",
      ".shape-types",
      ".bitmap-types",
      ".materials-types",
      ".texture-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../render/tsconfig.contract.json"
    },
    {
      "path": "../app/tsconfig.contract.json"
    },
    {
      "path": "../bitmap/tsconfig.contract.json"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../input"
    },
    {
      "path": "../layout"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../path/tsconfig.contract.json"
    },
    {
      "path": "../shape/tsconfig.contract.json"
    },
    {
      "path": "../signals"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.scene2d-dom-types.ts", "src/types/**/*.ts"]
}
