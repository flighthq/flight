{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".adjustments-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    {
      "path": "../adjustments/tsconfig.contract.json"
    },
    {
      "path": "../color"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../log"
    },
    {
      "path": "../types"
    },
    {
      "path": "./tsconfig.contract.json"
    }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.materials-types.ts", "src/types/**/*.ts"]
}
