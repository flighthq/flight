{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".render-types",
      ".render-gl-types",
      ".image-types",
      ".node-types",
      ".surface-types",
      ".text-types",
      ".textlayout-types",
      ".lighting-types",
      ".geometry-types",
      ".texture-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../image/tsconfig.contract.json"
    },
    {
      "path": "../render-gl/tsconfig.contract.json"
    },
    {
      "path": "../node/tsconfig.contract.json"
    },
    {
      "path": "../surface/tsconfig.contract.json"
    },
    {
      "path": "../text/tsconfig.contract.json"
    },
    {
      "path": "../textlayout/tsconfig.contract.json"
    },
    {
      "path": "../render/tsconfig.contract.json"
    },
    {
      "path": "../lighting/tsconfig.contract.json"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    }
  ],
  "include": [
    "src/contract.scene2d-gl-types.ts",
    "src/glRichTextOverlay.ts",
    "src/glShapeRendererData.ts",
    "src/types.ts"
  ]
}
