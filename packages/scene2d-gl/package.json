{
  "name": "@flighthq/scene2d-gl",
  "version": "0.5.0",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight.git",
    "directory": "packages/scene2d-gl"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.test.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "generate": "tsx ../../scripts/generate-rust-package.ts --crate flight-scene2d-gl --package scene2d-gl",
    "generate:check": "tsx ../../scripts/generate-rust-package.ts --crate flight-scene2d-gl --package scene2d-gl --check",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --watch --config vitest.config.ts",
    "prepack": "npm run clean && npm run clean:dist && npm run build",
    "clean:dist": "tsx ../../scripts/clean-package-dist.ts"
  },
  "dependencies": {
    "@flighthq/bitmaptext": "*",
    "@flighthq/color": "*",
    "@flighthq/entity": "*",
    "@flighthq/scene2d": "*",
    "@flighthq/scene2d-canvas": "*",
    "@flighthq/geometry": "*",
    "@flighthq/image": "*",
    "@flighthq/log": "*",
    "@flighthq/node": "*",
    "@flighthq/path": "*",
    "@flighthq/particleemitter": "*",
    "@flighthq/registry": "*",
    "@flighthq/render": "*",
    "@flighthq/render-gl": "*",
    "@flighthq/shape": "*",
    "@flighthq/surface": "*",
    "@flighthq/text": "*",
    "@flighthq/textformat": "*",
    "@flighthq/textinput": "*",
    "@flighthq/textlayout": "*",
    "@flighthq/texture": "*",
    "@flighthq/textureatlas": "*",
    "@flighthq/types": "*",
    "@flighthq/velocity": "*"
  },
  "devDependencies": {
    "@flighthq/bitmap": "*",
    "@flighthq/clip": "*",
    "@flighthq/glyphatlas": "*",
    "@flighthq/quadbatch": "*",
    "@flighthq/tilemap": "*",
    "typescript": "^7.0.2"
  },
  "description": "WebGL2 display-object renderers (bitmap, shape, sprite, text, tilemap, particles)",
  "sideEffects": false
}
