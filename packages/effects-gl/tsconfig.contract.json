{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".effects-types",
      ".render-types",
      ".render-gl-types",
      ".adjustments-types",
      ".lighting-types",
      ".geometry-types",
      ".texture-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../adjustments/tsconfig.contract.json"
    },
    {
      "path": "../effects/tsconfig.contract.json"
    },
    {
      "path": "../render-gl/tsconfig.contract.json"
    },
    {
      "path": "../render/tsconfig.contract.json"
    },
    {
      "path": "../lighting/tsconfig.contract.json"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.effects-gl-types.ts", "src/types.ts"]
}
