{
  "name": "@flighthq/physics2d-abi-wasm",
  "version": "0.5.0",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight.git",
    "directory": "packages/physics2d-abi-wasm"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/flight-physics2d-abi-wasm --target web --out-dir ../../packages/physics2d-abi-wasm/src/wasm --out-name physics2d_abi_wasm && node ../../scripts/embed-wasm-bytes.mjs src/wasm/physics2d_abi_wasm_bg.wasm src/wasm/physics2DAbiWasmBytes.ts physics2DAbiWasmBytes",
    "build": "tsc -b && node ../../scripts/copy-wasm-glue.mjs src/wasm/physics2d_abi_wasm.js dist/wasm/physics2d_abi_wasm.js",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@flighthq/physics2d-abi": "*",
    "@flighthq/types": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "description": "Wasm-backed drop-in replacement for @flighthq/physics2d-abi",
  "sideEffects": false
}
