{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".app-types", ".surface-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [{ "path": "../app/tsconfig.contract.json" }, { "path": "../surface/tsconfig.contract.json" }],
  "include": ["src/contract.render-gl-types.ts", "src/types.ts"]
}
