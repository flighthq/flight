{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".meshgeometry-types",
      ".render-types",
      ".render-backend-bridge-types",
      ".render-wgpu-bridge-types",
      ".render-wgpu-types",
      ".app-types",
      ".surface-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../app/tsconfig.contract.json"
    },
    {
      "path": "../meshgeometry/tsconfig.contract.json"
    },
    {
      "path": "../surface/tsconfig.contract.json"
    },
    {
      "path": "../types/tsconfig.render-wgpu-types.json"
    },
    {
      "path": "../render/tsconfig.contract.json"
    }
  ],
  "include": [
    "src/contract.render-gl-types.ts",
    "src/glCompressedTextureDecoderTypes.ts",
    "src/glCompressedTextureUploaderTypes.ts",
    "src/glContextRuntimeTypes.ts",
    "src/glContextStateTypes.ts",
    "src/glCustomMaterialShaderSourceTypes.ts",
    "src/glCubeRenderTargetTypes.ts",
    "src/glMeshMaterialRendererTypes.ts",
    "src/glModifierSnippetTypes.ts",
    "src/glPbrExtensionRegistrationTypes.ts",
    "src/glQuadMaterialRendererTypes.ts",
    "src/glRenderOptionsTypes.ts",
    "src/glRenderPassTypes.ts",
    "src/glRenderStateOptionsTypes.ts",
    "src/glRenderStateTypes.ts",
    "src/glRenderTargetTypes.ts",
    "src/glRenderTextureTypes.ts",
    "src/glTextureResolverTypes.ts",
    "src/types.ts"
  ]
}
