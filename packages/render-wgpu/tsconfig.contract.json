{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "moduleSuffixes": [
      ".meshgeometry-types",
      ".effects-types",
      ".render-types",
      ".render-wgpu-bridge-types",
      ".camera-types",
      ".adjustments-types",
      ".app-types",
      ".flow-types",
      ".geometry-types",
      ".font-types",
      ".host-types",
      ".image-types",
      ".materials-types",
      ".menu-types",
      ".midi-types",
      ".notification-types",
      ".path-boolean-types",
      ".path-types",
      ".permissions-types",
      ".platform-types",
      ".preferences-types",
      ".scene2d-dom-types",
      ".scene2d-formats-types",
      ".scene2d-wgpu-types",
      ".selection-types",
      ".shape-formats-types",
      ".shape-types",
      ".spatial-types",
      ".statechart-types",
      ".surface-types",
      ".text-types",
      ".textlayout-types",
      ".textshaper-types",
      ".texture-formats-types",
      ".texture-types",
      ".velocity-types",
      ".lighting-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../camera/tsconfig.contract.json"
    },
    {
      "path": "../effects/tsconfig.contract.json"
    },
    {
      "path": "../adjustments/tsconfig.contract.json"
    },
    {
      "path": "../app/tsconfig.contract.json"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../image/tsconfig.contract.json"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../meshgeometry/tsconfig.contract.json"
    },
    {
      "path": "../platform/tsconfig.contract.json"
    },
    {
      "path": "../signals"
    },
    {
      "path": "../surface/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
      "path": "../texture-formats/tsconfig.contract.json"
    },
    {
      "path": "../types/tsconfig.render-wgpu-types.json"
    },
    {
      "path": "../velocity/tsconfig.contract.json"
    },
    {
      "path": "../render/tsconfig.contract.json"
    },
    {
      "path": "../lighting/tsconfig.contract.json"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "./tsconfig.compressed-texture-decoder-contract.json"
    }
  ],
  "include": ["src/contract.render-wgpu-types.ts", "src/types/**/*.ts"]
}
