{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@testing-library/jest-dom", "vitest/globals", "@webgpu/types"],
    "moduleSuffixes": [".platform-types", ".surface-types", ".texture-formats-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    {
      "path": "../color"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../scene2d/tsconfig.runtime.json"
    },
    {
      "path": "../geometry/tsconfig.runtime.json"
    },
    {
      "path": "../log"
    },
    {
      "path": "../platform/tsconfig.contract.json"
    },
    {
      "path": "../render/tsconfig.runtime.json"
    },
    {
      "path": "../registry"
    },
    {
      "path": "../signals"
    },
    {
      "path": "../surface/tsconfig.contract.json"
    },
    {
      "path": "../bitmap/tsconfig.runtime.json"
    },
    {
      "path": "../texture/tsconfig.runtime.json"
    },
    {
      "path": "../texture-formats/tsconfig.contract.json"
    },
    {
      "path": "../types"
    },
    {
      "path": "./tsconfig.contract.json"
    }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.render-wgpu-types.ts", "src/types/**/*.ts"]
}
