{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".camera-types",
      ".meshgeometry-types",
      ".geometry-types",
      ".image-types",
      ".materials-types",
      ".lighting-types",
      ".texture-types",
      ".scene3d-node-types",
      ".adjustments-types",
      ".node-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../camera/tsconfig.contract.json"
    },
    {
      "path": "../animation"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../image/tsconfig.contract.json"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../meshgeometry/tsconfig.contract.json"
    },
    {
      "path": "../lighting/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "include": ["src/contract.scene3d-types.ts", "src/types/**/*.ts"],
  "exclude": [
    "src/contract.scene3d-node-types.ts",
    "src/types/Node3D.ts",
    "src/types/Skeleton3D.ts",
    "src/types/Skin.ts"
  ]
}
