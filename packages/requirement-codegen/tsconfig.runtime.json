{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../requirement" },
    { "path": "../requirement-catalog" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.requirement-codegen-types.ts", "src/types.ts"]
}
