    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../collision" },
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.runtime.json" },
    { "path": "../log" },
    { "path": "../math" },
    { "path": "../node/tsconfig.runtime.json" },
    { "path": "../scene3d" },
    { "path": "../spatial/tsconfig.runtime.json" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.physics3d-types.ts", "src/types.ts"]
}
