{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".skeleton2d-types",
      ".animation-types",
      ".entity-types",
      ".image-types",
      ".scene2d-types",
      ".shape-types",
      ".geometry-types",
      ".path-boolean-types",
      ".path-types",
      ".shape-types",
      ".effects-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../animation"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../image/tsconfig.contract.json"
    },
    {
      "path": "../importdiagnostics"
    },
    {
      "path": "../layout"
    },
    {
      "path": "../path/tsconfig.contract.json"
    },
    {
      "path": "../path-boolean/tsconfig.contract.json"
    },
    {
      "path": "../scene2d/tsconfig.contract.json"
    },
    {
      "path": "../shape/tsconfig.contract.json"
    },
    {
      "path": "../skeleton2d/tsconfig.contract.json"
    },
    {
      "path": "../xml"
    },
    {
      "path": "../effects/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.scene2d-formats-types.ts", "src/types/**/*.ts"]
}
