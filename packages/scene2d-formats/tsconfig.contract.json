{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".scene2d-formats-types",
      ".geometry-types",
      ".path-boolean-types",
      ".path-types",
      ".shape-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../path/tsconfig.contract.json" },
    { "path": "../types/tsconfig.scene2d-formats-types.json" }
  ],
  "include": ["src/contract.scene2d-formats-types.ts", "src/types/**/*.ts"]
}
