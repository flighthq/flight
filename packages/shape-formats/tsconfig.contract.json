{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".shape-types",
      ".scene2d-types",
      ".texture-types",
      ".node-types",
      ".materials-types",
      ".clip-types",
      ".geometry-types",
      ".path-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../shape/tsconfig.contract.json"
    },
    {
      "path": "../texture/tsconfig.contract.json"
    }
  ],
  "include": ["src/contract.shape-formats-types.ts", "src/types.ts"]
}
