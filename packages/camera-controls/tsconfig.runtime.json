{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["@testing-library/jest-dom", "vitest/globals", "@webgpu/types"],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../camera/tsconfig.runtime.json" },
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.runtime.json" },
    { "path": "../math" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/contract.camera-controls-types.ts",
    "src/CameraShakeContract.ts",
    "src/FlyCameraControllerContract.ts",
    "src/OrbitCameraControllerContract.ts"
  ]
}
