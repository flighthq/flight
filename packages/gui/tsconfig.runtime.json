{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".scene-document-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../interaction/tsconfig.runtime.json" },
    { "path": "../node/tsconfig.runtime.json" },
    { "path": "../scene-document/tsconfig.contract.json" },
    { "path": "../signals" },
    { "path": "../text/tsconfig.runtime.json" },
    { "path": "../textinput/tsconfig.runtime.json" },
    { "path": "../types" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/contract.gui-types.ts", "src/types/**/*.ts"]
}
