{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".materials-types", ".node-types", ".scene2d-types", ".textureatlas-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../materials/tsconfig.contract.json" },
    { "path": "../node/tsconfig.contract.json" },
    { "path": "../scene2d/tsconfig.contract.json" },
    { "path": "../signals" },
    { "path": "../textureatlas/tsconfig.contract.json" }
  ],
  "include": ["src/contract.tilemap-types.ts", "src/types.ts"]
}
