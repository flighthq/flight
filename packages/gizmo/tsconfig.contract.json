{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".camera-types", ".geometry-types", ".node-types", ".scene2d-types", ".selection-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    { "path": "../camera/tsconfig.contract.json" },
    { "path": "../entity" },
    { "path": "../geometry/tsconfig.contract.json" },
    { "path": "../node/tsconfig.contract.json" },
    { "path": "../scene2d/tsconfig.contract.json" },
    { "path": "../selection/tsconfig.contract.json" },
    { "path": "../signals" }
  ],
  "include": ["src/contract.gizmo-types.ts", "src/types.ts"]
}
