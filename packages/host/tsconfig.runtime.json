{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    { "path": "../entity" },
    { "path": "../log" },
    { "path": "../types" },
    { "path": "./tsconfig.contract.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/backendExplanation.ts",
    "src/backendOperationExplanation.ts",
    "src/contract.host-types.ts",
    "src/hostExplanation.ts",
    "src/inputIngressSource.ts",
    "src/providerRef.ts"
  ]
}
