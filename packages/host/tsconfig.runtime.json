{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".keyboard-types", ".platform-types", ".video-types", ".textshaper-types", ".surface-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.runtime"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../geolocation"
    },
    {
      "path": "../keyboard/tsconfig.contract.json"
    },
    {
      "path": "../log"
    },
    {
      "path": "../platform/tsconfig.contract.json"
    },
    {
      "path": "../surface/tsconfig.contract.json"
    },
    {
      "path": "../textshaper/tsconfig.contract.json"
    },
    {
      "path": "../types"
    },
    {
      "path": "../video/tsconfig.contract.json"
    },
    {
      "path": "./tsconfig.contract.json"
    }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/backendExplanation.ts",
    "src/backendOperationExplanation.ts",
    "src/contract.host-types.ts",
    "src/hostCapabilities.ts",
    "src/hostExplanation.ts",
    "src/inputIngressSource.ts",
    "src/providerRef.ts"
  ]
}
