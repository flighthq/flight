{
  "name": "@flighthq/scene3d-wgpu",
  "version": "0.5.0",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight.git",
    "directory": "packages/scene3d-wgpu"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.test.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "generate": "tsx ../../scripts/generate-rust-package.ts --crate flight-scene3d-wgpu --package scene3d-wgpu",
    "generate:check": "tsx ../../scripts/generate-rust-package.ts --crate flight-scene3d-wgpu --package scene3d-wgpu --check",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --watch --config vitest.config.ts",
    "prepack": "npm run clean && npm run clean:dist && npm run build",
    "clean:dist": "tsx ../../scripts/clean-package-dist.ts"
  },
  "dependencies": {
    "@flighthq/camera": "*",
    "@flighthq/color": "*",
    "@flighthq/entity": "*",
    "@flighthq/geometry": "*",
    "@flighthq/image": "*",
    "@flighthq/lighting": "*",
    "@flighthq/log": "*",
    "@flighthq/materials": "*",
    "@flighthq/meshgeometry": "*",
    "@flighthq/node": "*",
    "@flighthq/particles": "*",
    "@flighthq/particleemitter": "*",
    "@flighthq/registry": "*",
    "@flighthq/render": "*",
    "@flighthq/render-wgpu": "*",
    "@flighthq/scene2d-wgpu": "*",
    "@flighthq/scene3d": "*",
    "@flighthq/shading": "*",
    "@flighthq/texture": "*",
    "@flighthq/textureatlas": "*",
    "@flighthq/types": "*"
  },
  "peerDependencies": {
    "@webgpu/types": "^0.1.70"
  },
  "devDependencies": {
    "@flighthq/bitmaptext": "*",
    "@flighthq/shape": "*",
    "@flighthq/text": "*",
    "@flighthq/tilemap": "*",
    "@flighthq/video": "*",
    "@webgpu/types": "*",
    "typescript": "^7.0.2"
  },
  "description": "WebGPU 3D scene renderer",
  "sideEffects": false
}
