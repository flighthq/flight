{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["@webgpu/types"],
    "moduleSuffixes": [".scene3d-wgpu-bridge-types", ".materials-types", ".render-wgpu-types", ".geometry-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../render-wgpu/tsconfig.contract.json"
    },
    {
      "path": "../types/tsconfig.scene3d-wgpu-types.json"
    }
  ],
  "include": ["src/contract.scene3d-wgpu-types.ts", "src/types/**/*.ts"]
}
