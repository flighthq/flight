{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [
      ".clip-types",
      ".geometry-types",
      ".materials-types",
      ".node-types",
      ".scene2d-types",
      ".texture-types",
      ".textureatlas-types",
      ""
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../scene2d/tsconfig.contract.json"
    },
    {
      "path": "../textureatlas/tsconfig.contract.json"
    },
    {
      "path": "../signals"
    }
  ],
  "include": ["src/contract.quadbatch-types.ts", "src/types.ts"]
}
