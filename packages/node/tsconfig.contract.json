{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleSuffixes": [".adjustments-types", ".materials-types", ".geometry-types", ""],
    "tsBuildInfoFile": "dist/.tsbuildinfo.contract"
  },
  "references": [
    {
      "path": "../adjustments/tsconfig.contract.json"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../geometry/tsconfig.contract.json"
    },
    {
      "path": "../layout"
    },
    {
      "path": "../materials/tsconfig.contract.json"
    },
    {
      "path": "../signals"
    }
  ],
  "include": ["src/contract.node-types.ts", "src/types/**/*.ts"]
}
