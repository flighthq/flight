src/types.rs: impl Entity for ResourceLoaderItemSignals :: fn entity_runtime(&self) -> &EntityRuntimeSlot
src/types.rs: impl Entity for ResourceLoaderItemSignals :: fn entity_runtime_mut(&mut self) -> &mut EntityRuntimeSlot
src/types.rs: pub type ResourceLoadBytesReporter = Arc<dyn Fn(f32, Option<f32>) + Send + Sync>;
src/types.rs: pub type ResourceLoadFuture<T> = Pin<Box<dyn Future<Output = ResourceLoadResult<T>> + Send>>;
src/types.rs: pub type ResourceLoadReports = Ref<Vec<Ref<ResourceLoadReport>>>;
src/types.rs: pub type ResourceLoadResult<T> = Result<T, Unknown>;
