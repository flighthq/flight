src/types.rs: #[derive(Clone)] pub enum ResourceLoadInput<T> { Item(ResourceLoadItem<T>), Thunk(ResourceLoadThunk<T>), }
src/types.rs: #[derive(Clone)] pub struct ResourceLoadHandle<T: Clone> { pub key: String, pub promise: SharedFuture<ResourceLoadResult<T>>, }
src/types.rs: #[derive(Clone)] pub struct ResourceLoadItem<T> { pub bytes_hint: Option<f32>, pub group: Option<String>, pub key: Option<String>, pub load: Arc<dyn Fn(AbortSignal, ResourceLoadBytesReporter) -> ResourceLoadFuture<T> + Send + Sync>, pub on_bytes_progress: Option<Arc<dyn Fn(f32, f32) + Send + Sync>>, pub priority: Option<f32>, pub retries: Option<f32>, pub timeout_ms: Option<f64>, pub weight: Option<f32>, }
src/types.rs: #[derive(Clone)] pub struct ResourceLoadThunk<T> { pub load: Arc<dyn Fn() -> ResourceLoadFuture<T> + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct ResourceLoaderContext { pub spawn: HostSpawnCapability, pub timers: HostTimerCapability, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct ResourceLoadBytes { pub bytes_loaded: f32, pub bytes_total_known: f32, pub items_with_known_bytes: usize, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct ResourceLoaderOptions { pub dedupe: Option<bool>, pub error_policy: Option<ResourceLoaderErrorPolicy>, pub max_bytes_per_second: Option<f32>, pub max_concurrent: Option<f32>, pub retries: Option<f32>, pub retry_backoff: Option<ResourceLoaderRetryBackoff>, pub retry_base_delay_ms: Option<f64>, pub retry_max_delay_ms: Option<f64>, pub streaming: Option<bool>, pub timeout_ms: Option<f64>, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct ResourceLoadCounts { pub settled_items: usize, pub in_flight_items: usize, pub queued_items: usize, pub total_items: usize, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct ResourceLoadReport { pub attempts: usize, pub bytes: f32, pub elapsed_ms: f64, pub group: Option<String>, pub key: String, pub status: ResourceLoadReportStatus, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct LoadProgress { pub url: String, pub loaded: usize, pub total: usize, pub phase: NetProgressPhase, }
src/types.rs: #[derive(Clone, Default)] pub struct LoadOptions { pub signal: Option<AbortSignal>, pub progress: Option<Ref<Signal<Ref<LoadProgress>>>>, }
src/types.rs: #[derive(Clone, Default)] pub struct ResourceLoader { pub on_cancel: Signal<()>, pub on_complete: Signal<ResourceLoadReports>, pub on_error: Signal<(Unknown, String)>, pub on_pause: Signal<()>, pub on_progress: Signal<f32>, pub on_resume: Signal<()>, pub(crate) state: Ref<ResourceLoaderInternal>, runtime: EntityRuntimeSlot, }
src/types.rs: #[derive(Clone, Default)] pub struct ResourceLoaderItemSignals { pub on_item_complete: Signal<(String, Unknown)>, pub on_item_error: Signal<(String, Unknown, usize)>, pub on_item_retry: Signal<(String, usize, f64)>, pub on_item_start: Signal<String>, runtime: EntityRuntimeSlot, }
