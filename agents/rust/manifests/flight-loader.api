src/types.rs: impl Entity for ResourceLoader :: fn entity_runtime(&self) -> &EntityRuntimeSlot
src/types.rs: impl Entity for ResourceLoader :: fn entity_runtime_mut(&mut self) -> &mut EntityRuntimeSlot
