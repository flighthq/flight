src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum GlobalShortcutDetachReason { Detached, NotAttached, TriggerProviderFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum GlobalShortcutQueryReason { NotRegistered, QueryProviderFailed, Registered, Unparseable, }
