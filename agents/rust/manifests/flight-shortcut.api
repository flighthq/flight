src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShortcutEditingKeyName { Backspace, Delete, Escape, Insert, Return, Space, Tab, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShortcutFunctionKeyName { F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15, F16, F17, F18, F19, F20, F21, F22, F23, F24, }
