src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq)] pub struct FileStat { pub size: usize, pub is_directory: bool, pub modified_time: f64, pub created_time: f64, pub is_symlink: bool, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub struct FilePermissions { pub readable: bool, pub writable: bool, pub executable: bool, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub struct FileSystemUsage { pub used_bytes: usize, pub quota_bytes: usize, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum FileAccessMode { Executable, Readable, Writable, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum FileSystemPathKind { AppData, Cache, Desktop, Documents, Downloads, Home, Temp, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum FileWatchEventType { Created, Deleted, Modified, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct FileEntry { pub name: String, pub path: String, pub is_directory: bool, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct FileWatchEvent { pub type_: FileWatchEventType, pub path: String, }
src/types.rs: #[derive(Clone, Default)] pub struct FileWalkOptions { pub max_depth: Option<f64>, pub signal: Option<AbortSignal>, }
src/types.rs: #[derive(Clone, Default)] pub struct HostFileSystemCapabilities { pub access: Option<HostFileSystemCapability>, }
src/types.rs: pub enum FileAtomicWriteData<'a> { Bytes(FileAtomicWriteBytes<'a>), Text(FileAtomicWriteText<'a>), }
src/types.rs: pub struct FileAtomicWriteBytes<'a> { pub data: &'a Uint8Array, }
src/types.rs: pub struct FileAtomicWriteText<'a> { pub data: &'a str, }
src/types.rs: pub type FileSystemProviderFuture<T> = Pin<Box<dyn Future<Output = Result<T, FlightError>> + Send>>;
src/types.rs: pub type FileWatchListener = Arc<dyn Fn(&FileWatchEvent) + Send + Sync>;
src/types.rs: pub type FileWatchUnsubscribe = Arc<dyn Fn() + Send + Sync>;
