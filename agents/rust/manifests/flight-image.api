src/types.rs: #[derive(Clone, Debug)] pub struct ImageResource { pub(crate) fields: TextureSourceFields, pub source: Arc<HostImageSource>, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct ImageUrlOriginContext { pub href: String, pub origin: String, }
src/types.rs: #[derive(Clone, Default)] pub struct HostImageCapabilities { pub loader: Option<HostImageCapability>, }
src/types.rs: #[derive(Clone, Default)] pub struct ImageResolverState { pub(crate) bitmap_composition_resolver: Option<ImageBitmapCompositionResolver>, pub(crate) dimension_resolver: Option<HostImageDimensionResolver>, }
src/types.rs: #[derive(Clone, Default)] pub struct ImageResourceFailure { pub kind: ImageResourceFailureKind, pub message: String, pub name: Option<String>, runtime: EntityRuntimeSlot, }
