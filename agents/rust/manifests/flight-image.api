src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum ImageResourceFailureKind { #[default] Error, Unavailable, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum ImageResourceReferenceKind { #[default] Embedded, External, }
