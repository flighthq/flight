src/types.rs: #[derive(Clone, Debug)] pub struct BitmapReadbackResolution { pub bitmap: Option<Bitmap>, pub reason: BitmapReadbackBlockReason, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapRegion { pub bitmap: Bitmap, pub x: i32, pub y: i32, pub width: i32, pub height: i32, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapResizeOptions { pub mode: Option<BitmapResizeMode>, pub edge_mode: Option<BitmapEdgeMode>, pub premultiplied: Option<bool>, }
