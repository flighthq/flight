src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] #[repr(u8)] pub enum BitmapCompositeMode { Normal = 0, Multiply = 1, Screen = 2, Add = 3, Subtract = 4, Darken = 5, Lighten = 6, Difference = 7, Exclusion = 8, Overlay = 9, HardLight = 10, SoftLight = 11, ColorDodge = 12, ColorBurn = 13, Invert = 14, SourceOver = 15, DestinationOver = 16, SourceIn = 17, DestinationIn = 18, SourceOut = 19, DestinationOut = 20, SourceAtop = 21, DestinationAtop = 22, Xor = 23, Copy = 24, Clear = 25, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] #[repr(u8)] pub enum ImageChannel { Red = 0, Green = 1, Blue = 2, Alpha = 3, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum BitmapBevelType { Inner, Outer, Both, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum BitmapEdgeMode { Transparent, Clamp, Wrap, Mirror, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum BitmapReadbackMode { Bitmap, Probe, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum BitmapResizeMode { Nearest, Bilinear, Bicubic, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum DisplacementMode { Wrap, Clamp, Ignore, Color, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum GradientSpread { Pad, Repeat, Reflect, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum ImageFormat { Png, Jpeg, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum PixelOrder { Rgba, Bgra, Argb, Abgr, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum ThresholdOperation { LessThan, LessThanOrEqual, GreaterThan, GreaterThanOrEqual, Equal, NotEqual, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum BitmapReadbackBackendReason { NoCanvas, Ok, TaintedSource, }
src/types.rs: #[derive(Clone, Debug)] pub struct Bitmap { pub(crate) fields: TextureSourceFields, pub data: Box<Uint8Array>, pub format: PixelFormat, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapBevelOptions { pub angle: Option<f32>, pub distance: Option<f32>, pub type_: Option<BitmapBevelType>, pub intensity: Option<f32>, pub highlight_color: Option<u32>, pub shadow_color: Option<u32>, pub radius_x: Option<f32>, pub radius_y: Option<f32>, pub passes: Option<i32>, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapBoxBlurOptions { pub radius_x: Option<i32>, pub radius_y: Option<i32>, pub passes: Option<i32>, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapConvolutionOptions { pub matrix: Vec<f32>, pub matrix_x: i32, pub matrix_y: i32, pub divisor: Option<f32>, pub bias: Option<f32>, pub edge: Option<BitmapEdgeMode>, pub preserve_alpha: Option<bool>, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapDisplacementMapOptions { pub map: BitmapRegion, pub component_x: Option<u32>, pub component_y: Option<u32>, pub scale_x: Option<f32>, pub scale_y: Option<f32>, pub edge_mode: Option<BitmapEdgeMode>, pub mode: Option<DisplacementMode>, pub fill_color: Option<u32>, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapEncodeFailureExplanation { pub format: ImageFormat, pub reason: String, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapFingerprint { runtime: EntityRuntimeSlot, pub grid_size: u32, pub cells: Vec<u8>, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapGradientBevelOptions { pub angle: Option<f32>, pub distance: Option<f32>, pub type_: Option<BitmapBevelType>, pub intensity: Option<f32>, pub radius_x: Option<f32>, pub radius_y: Option<f32>, pub passes: Option<i32>, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapHistogram { pub red: Vec<u32>, pub green: Vec<u32>, pub blue: Vec<u32>, pub alpha: Vec<u32>, }
src/types.rs: #[derive(Clone, Debug)] pub struct BitmapReadbackExplanation { pub readable: bool, pub reason: BitmapReadbackBlockReason, }
