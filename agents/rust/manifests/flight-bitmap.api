src/types.rs: #[derive(Clone, Debug, Default)] pub struct BitmapGlowOptions { pub color: Option<u32>, pub intensity: Option<f32>, pub radius_x: Option<f32>, pub radius_y: Option<f32>, pub passes: Option<i32>, }
