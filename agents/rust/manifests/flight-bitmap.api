src/types.rs: #[derive(Clone, Debug, Default)] pub struct BitmapInnerShadowOptions { pub color: Option<u32>, pub intensity: Option<f32>, pub offset_x: Option<i32>, pub offset_y: Option<i32>, pub radius_x: Option<f32>, pub radius_y: Option<f32>, pub passes: Option<i32>, }
src/types.rs: #[derive(Clone, Debug, Default)] pub struct BitmapMismatch { pub mismatched_pixels: u32, pub total_pixels: u32, pub fraction: f64, pub max_channel_delta: u32, }
src/types.rs: #[derive(Clone, Debug, Default)] pub struct BitmapShadowBlurOptions { pub radius_x: Option<f32>, pub radius_y: Option<f32>, pub passes: Option<i32>, }
src/types.rs: #[derive(Clone, Debug, Default)] pub struct BitmapSharpenOptions { pub amount: Option<f32>, pub radius_x: Option<i32>, pub radius_y: Option<i32>, pub passes: Option<i32>, }
