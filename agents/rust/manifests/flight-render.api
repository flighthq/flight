src/types.rs: pub struct RenderProxy<S: RenderState> { pub(crate) runtime: EntityRuntimeSlot, pub source: NodeRef, pub kind: Kind, pub next: Option<u64>, pub alpha: f32, pub appearance_frame_id: i64, pub blend_mode: Option<BlendMode>, pub color_scale_bias: Option<ColorScaleBias>, pub color_matrix: Option<[f32; 20]>, pub material: Option<Ref<dyn Material2D>>, pub material_data: Option<Ref<dyn MaterialData>>, pub last_appearance_id: i64, pub last_children_id: i64, pub last_local_content_id: i64, pub last_local_transform_id: i64, pub last_parent_reference_id: i64, pub name: Option<String>, pub renderer: Option<&'static NodeRenderer<S>>, pub renderer_data: Option<RendererDataRef>, pub renderer_data_source_id: u64, pub renderer_map_id: u32, pub transform_frame_id: i64, pub visible: bool, }
src/types.rs: pub struct RenderProxyAdapter<S: RenderState> { pub(crate) runtime: EntityRuntimeSlot, pub adapt: fn(&mut RenderProxyAdapter<S>, &mut S, &NodeRef, &mut RenderProxy2D<S>) -> Option<bool>, pub cache: Option<Ref<RenderCache>>, pub signals: Option<RenderCacheAdapterSignals>, pub is_cache_adapter: bool, }
src/types.rs: pub struct RenderQueue { runtime: EntityRuntimeSlot, pub entries: Vec<RenderQueueEntry>, pub entry_count: usize, }
src/types.rs: pub struct RenderRegistries<S: RenderState> { pub canvas_shape_commands: Option<Arc<KindMap<UnknownValue>>>, pub clip_hooks: Option<&'static Scene2DClipHooks<S>>, pub color_adjustments: Option<ColorAdjustmentResolver<S>>, pub color_adjustment_unsupported_guard: Option<ColorAdjustmentUnsupportedGuard<S>>, pub effect_padding_resolvers: Option<Arc<KindMap<EffectPaddingResolver>>>, pub node_renderers: Arc<KindMap<&'static NodeRenderer<S>>>, pub render_root_guard: Option<RenderRootGuard<S>>, pub skinned_mesh_bounds_guard: Option<fn(&mut S, &flight_scene3d::Mesh)>, pub stroke_tessellator: Option<StrokeTessellator>, }
src/types.rs: pub struct RenderStateFields { runtime: EntityRuntimeSlot, pub allow_smoothing: bool, pub current_clip_depth: u32, pub pixel_ratio: f32, pub render_alpha: f32, pub render_blend_mode: Option<BlendMode>, pub round_pixels: bool, pub scene_graph_sync_policy: Scene3DGraphSyncPolicy, }
src/types.rs: pub struct RenderStateOptions<S: RenderState> { pub canvas_shape_commands: Option<KindMap<UnknownValue>>, pub clip_hooks: Option<&'static Scene2DClipHooks<S>>, pub color_adjustments: Option<Option<ColorAdjustmentResolver<S>>>, pub color_adjustment_unsupported_guard: Option<Option<ColorAdjustmentUnsupportedGuard<S>>>, pub effect_padding_resolvers: Option<KindMap<EffectPaddingResolver>>, pub node_renderers: Option<KindMap<&'static NodeRenderer<S>>>, pub render_root_guard: Option<Option<RenderRootGuard<S>>>, pub stroke_tessellator: Option<Option<StrokeTessellator>>, }
src/types.rs: pub struct RenderStateRuntime<S: RenderState> { pub current_frame_id: u32, pub render_adapt_hook: Option<fn(&mut S, &NodeRef, &mut RenderProxy2D<S>)>, pub render_proxy_adapter_map: HashMap<u64, Ref<RenderProxyAdapter<S>>>, pub registry_signals: Option<RenderRegistrySignals>, pub registry_guard_enabled: bool, pub registry_misses: Ref<Vec<RenderRegistriesMiss>>, pub registry_guard_log: Option<LogStateRef>, pub renderer_map_id: u32, pub node_revisions: NodeRevisionState, pub prepared_scene3d: Option<PreparedScene3D>, }
src/types.rs: pub struct Scene2DClipHooks<S: RenderState> { pub finalize: fn(&mut S), pub pop_clip: fn(&mut S, &RenderProxy2D<S>, &NodeRef), pub push_clip: fn(&mut S, &RenderProxy2D<S>, &NodeRef), }
