src/types.rs: pub trait RenderState: Entity + Sized + 'static { fn render_state(&self) -> &RenderStateFields; fn render_state_mut(&mut self) -> &mut RenderStateFields; fn render_runtime(&self) -> &RenderStateRuntime<Self>; fn render_runtime_mut(&mut self) -> &mut RenderStateRuntime<Self>; fn render_registries(&self) -> &RenderRegistries<Self>; fn render_registries_mut(&mut self) -> &mut RenderRegistries<Self>; }
