src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum AccessibilityLiveness { Polite, Assertive, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum AccessibilityOperationBlockReason { Destroyed, FocusNotMoved, NoDom, NodeNotFound, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum AccessibilityOperationOutcome<R = AccessibilityOperationBlockReason> { Ok(AccessibilityOperationOutcomeOk), Blocked(AccessibilityOperationOutcomeBlocked<R>), }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum AccessibilityRemoveNodeBlockReason { Destroyed, NoDom, NodeNotFound, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum AccessibilityTreeBlockReason { Destroyed, NoDom, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct AccessibilityOperationOutcomeBlocked<R> { pub reason: R, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct AccessibilityOperationOutcomeOk { }
src/types.rs: #[derive(Clone, Debug)] pub struct AccessibilityNode { pub id: String, pub role: AccessibilityRole, pub label: Option<String>, pub description: Option<String>, pub value: Option<String>, pub parent_id: Option<String>, pub bounds: Option<Ref<Rectangle>>, pub states: Option<AccessibilityState>, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct AccessibilityState { pub disabled: Option<bool>, pub checked: Option<bool>, pub expanded: Option<bool>, pub selected: Option<bool>, pub pressed: Option<bool>, pub busy: Option<bool>, pub hidden: Option<bool>, pub readonly: Option<bool>, pub required: Option<bool>, pub level: Option<f32>, pub value_min: Option<f32>, pub value_max: Option<f32>, pub value_now: Option<f32>, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct AccessibilityDescriptor { pub label: Option<String>, pub role: Option<String>, pub tab_focusable: Option<bool>, }
src/types.rs: #[derive(Clone, Default)] pub struct HostAccessibilityCapabilities { pub tree: Option<HostAccessibilityCapability>, }
