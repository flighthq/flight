src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum TextMarkupIssueKind { UnknownTag, UnresolvedFontColor, UnsafeHref, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct MarkupTagEffect { pub break_before: Option<bool>, pub format: Option<TextFormat>, pub text: Option<String>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub enum MarkupTagResult { Effect(MarkupTagEffect), Format(TextFormat), }
src/types.rs: #[derive(Default)] pub struct MarkupResolverSeams { pub class_resolver: Option<MarkupClassResolver>, pub color_resolver: Option<MarkupColorResolver>, }
src/types.rs: #[derive(Default)] pub struct TextMarkupGuardState { pub guard: Option<TextMarkupGuard>, }
src/types.rs: pub fn create_text_markup_guard_state() -> TextMarkupGuardState
src/types.rs: pub fn get_text_markup_issue_kind_string(value: TextMarkupIssueKind) -> &'static str
src/types.rs: pub fn parse_text_markup_issue_kind(value: &str) -> Option<TextMarkupIssueKind>
src/types.rs: pub struct MarkupTagRegistry { pub handlers: Vec<(String, MarkupTagHandler)>, pub seams: Ref<MarkupResolverSeams>, }
src/types.rs: pub struct TextMarkupExplanation { pub issues: Vec<TextMarkupIssue>, }
src/types.rs: pub struct TextMarkupIssue { pub kind: TextMarkupIssueKind, pub offset: usize, pub tag: String, pub value: Option<String>, }
src/types.rs: pub type MarkupClassResolver = Arc<dyn Fn(&str) -> Option<TextFormat> + Send + Sync>;
src/types.rs: pub type MarkupColorResolver = Arc<dyn Fn(&str) -> Option<u32> + Send + Sync>;
src/types.rs: pub type MarkupTagHandler = Arc<dyn Fn(&Record<String>, &TextFormat) -> MarkupTagResult + Send + Sync>;
src/types.rs: pub type TextMarkupClock = Arc<dyn Fn() -> f64 + Send + Sync>;
src/types.rs: pub type TextMarkupGuard = Arc<dyn Fn(&TextMarkupIssue) + Send + Sync>;
