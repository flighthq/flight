src/types.rs: pub trait ShapeNode: flight_scene2d::contract::Node2D + Sized { fn shape_commands(&self) -> &Vec<ShapeCommandToken>; fn shape_commands_mut(&mut self) -> &mut Vec<ShapeCommandToken>; fn shape_bounds_state(&self) -> ShapeBoundsStateRef; fn shape_runtime(&self) -> ShapeRuntimeRef; fn clear_shape_paint_bindings(&mut self); }
