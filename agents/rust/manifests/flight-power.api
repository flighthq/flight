src/types.rs: #[derive(Clone)] pub struct HostPowerBatteryHealthCapability { pub get_battery_health: Arc<dyn Fn(&mut PowerBatteryHealth) -> PowerBatteryHealth + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPowerChangeCapability { pub subscribe: Arc<dyn Fn(PowerChangeListener) -> PowerUnsubscribe + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPowerIdleCapability { pub get_idle_state: Arc<dyn Fn(f32) -> PowerIdleState + Send + Sync>, pub get_idle_time_seconds: Arc<dyn Fn() -> f32 + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPowerKeepAwakeCapability { pub acquire: Arc<dyn Fn(PowerKeepAwakeMode) -> PowerKeepAwakeAcquireFuture + Send + Sync>, pub destroy: Option<Arc<dyn Fn() + Send + Sync>>, pub is_active: Arc<dyn Fn() -> bool + Send + Sync>, pub provider: ProviderRef, pub release: Arc<dyn Fn() -> PowerKeepAwakeReleaseFuture + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPowerSessionLockCapability { pub subscribe_lock: Arc<dyn Fn(PowerChangeListener) -> PowerUnsubscribe + Send + Sync>, pub subscribe_unlock: Arc<dyn Fn(PowerChangeListener) -> PowerUnsubscribe + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPowerStatusCapability { pub get_status: Arc<dyn Fn(&mut PowerStatus) -> PowerStatus + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPowerSuspensionCapability { pub subscribe_resume: Arc<dyn Fn(PowerChangeListener) -> PowerUnsubscribe + Send + Sync>, pub subscribe_suspend: Arc<dyn Fn(PowerChangeListener) -> PowerUnsubscribe + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPowerThermalCapability { pub get_thermal_state: Arc<dyn Fn() -> PowerThermalState + Send + Sync>, pub subscribe_thermal_state_change: Arc<dyn Fn(PowerThermalListener) -> PowerUnsubscribe + Send + Sync>, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PowerBatteryHealthState { Good, Fair, Poor, Unknown, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PowerIdleState { Active, Idle, Unknown, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PowerKeepAwakeAcquireReason { Ok, Unavailable, Denied, Failed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PowerKeepAwakeMode { PreventDisplaySleep, PreventAppSuspension, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PowerKeepAwakeReleaseReason { Ok, Inactive, Failed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PowerThermalState { Nominal, Fair, Serious, Critical, Unknown, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct PowerBatteryHealth { pub capacity_wear_level: f32, pub cycle_count: i32, pub health_state: PowerBatteryHealthState, pub temperature_celsius: f32, pub voltage: f32, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct PowerStatus { pub battery_level: f32, pub charging_time: f32, pub discharging_time: f32, pub is_battery_low: bool, pub is_charging: bool, pub is_low_power: bool, pub is_on_battery: bool, pub thermal_state: PowerThermalState, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct PowerKeepAwakeAcquireResult { pub reason: PowerKeepAwakeAcquireReason, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct PowerKeepAwakeReleaseResult { pub reason: PowerKeepAwakeReleaseReason, }
src/types.rs: #[derive(Clone, Default)] pub struct HostPowerCapabilities { pub battery_health: Option<HostPowerBatteryHealthCapability>, pub change: Option<HostPowerChangeCapability>, pub idle: Option<HostPowerIdleCapability>, pub keep_awake: Option<HostPowerKeepAwakeCapability>, pub session_lock: Option<HostPowerSessionLockCapability>, pub status: Option<HostPowerStatusCapability>, pub suspension: Option<HostPowerSuspensionCapability>, pub thermal: Option<HostPowerThermalCapability>, }
