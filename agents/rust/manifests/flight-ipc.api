src/types.rs: pub type IpcArguments = Vec<AnySlot>;
src/types.rs: pub type IpcHandle = Arc<dyn Fn(String, IpcInvokeHandler) -> IpcUnsubscribe + Send + Sync>;
src/types.rs: pub type IpcInvoke = Arc<dyn Fn(String, IpcArguments) -> IpcInvokeFuture + Send + Sync>;
src/types.rs: pub type IpcInvokeFuture = Pin<Box<dyn Future<Output = IpcInvokeResult> + Send>>;
src/types.rs: pub type IpcInvokeHandler = Arc<dyn Fn(&[AnySlot]) -> IpcInvokeFuture + Send + Sync>;
src/types.rs: pub type IpcInvokeResult = Result<AnySlot, FlightError>;
src/types.rs: pub type IpcMessageListener = Arc<dyn Fn(&[AnySlot]) + Send + Sync>;
src/types.rs: pub type IpcSend = Arc<dyn Fn(&str, IpcArguments) + Send + Sync>;
src/types.rs: pub type IpcSubscribe = Arc<dyn Fn(String, IpcMessageListener) -> IpcUnsubscribe + Send + Sync>;
src/types.rs: pub type IpcTargetedSend<Target> = Arc<dyn Fn(&Target, &str, IpcArguments) + Send + Sync>;
src/types.rs: pub type IpcUnsubscribe = Arc<dyn Fn() + Send + Sync>;
