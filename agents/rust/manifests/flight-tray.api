src/results.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum TrayInteractionType { Click, DoubleClick, RightClick, }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayAnimationStartResult { Started(TrayEventRelease), Empty, TrayDestroyed, InvalidIcon(TrayFailure), ImageUpdateFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayAnimationStopResult { Stopped, AlreadyStopped, }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayBalloonDisplayResult { Displayed, TrayDestroyed, BalloonDisplayFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayBalloonRemoveResult { Removed, TrayDestroyed, BalloonNotActive, BalloonRemoveFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayBoundsResult { Available(TrayBoundsReading), TrayDestroyed, BoundsReadFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayCreateCapabilityResult { Created, Cancelled, RuntimeApiUnavailable(TrayFailure), InvalidIcon(TrayFailure), TrayCreateFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayDestroyCapabilityResult { Destroyed, TrayDestroyFailed(TrayDestroyFailures), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayDestroyResult { Destroyed, TrayDestroyFailed(TrayDestroyFailures), AlreadyDestroyed, }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayDoubleClickPolicyUpdateResult { Updated, TrayDestroyed, DoubleClickPolicyUpdateFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayEventAttachResult { Attached(TrayEventRelease), TrayDestroyed, SubscriptionFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayImageUpdateResult { Updated, TrayDestroyed, InvalidIcon(TrayFailure), ImageUpdateFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayMenuUpdateResult { Updated, TrayDestroyed, MenuBuildFailed(TrayFailure), MenuInstallFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayPopupMenuResult { Shown, TrayDestroyed, MenuNotSet, PopupFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayPressedImageUpdateResult { Updated, TrayDestroyed, InvalidIcon(TrayFailure), PressedImageUpdateFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayReleaseResult { Released, AlreadyReleased, ReleaseFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayTemplateImageUpdateResult { Updated, TrayDestroyed, TemplateImageUpdateFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayTitleReadResult { Available(TrayTitleReading), TrayDestroyed, TitleReadFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayTitleUpdateResult { Updated, TrayDestroyed, TitleUpdateFailed(TrayFailure), }
src/results.rs: #[derive(Clone, Debug)] pub enum TrayTooltipReadResult { Available(TrayTooltipReading), TrayDestroyed, TooltipReadFailed(TrayFailure), }
