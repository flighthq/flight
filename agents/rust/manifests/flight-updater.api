src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum AppUpdateCheckReason { Downloaded, CheckInProgress, NotAvailable, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum AppUpdateInstallReason { Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct AppUpdateCheckOutcomeCheckInProgress { }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct AppUpdateCheckOutcomeNotAvailable { }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct AppUpdateCheckOutcomeOperationFailed { }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct AppUpdateInstallOutcome { pub reason: AppUpdateInstallReason, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct DownloadedUpdate { runtime: EntityRuntimeSlot, pub info: UpdateInfo, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct UpdateInfo { pub download_size_bytes: Option<i64>, pub is_mandatory: Option<bool>, pub minimum_os_version: Option<String>, pub notes: Option<String>, pub release_date: Option<String>, pub sha512: Option<String>, pub version: Option<String>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub enum AppUpdateCheckOutcome { Downloaded(AppUpdateCheckOutcomeDownloaded), CheckInProgress(AppUpdateCheckOutcomeCheckInProgress), NotAvailable(AppUpdateCheckOutcomeNotAvailable), OperationFailed(AppUpdateCheckOutcomeOperationFailed), }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct AppUpdateCheckOutcomeDownloaded { pub update: DownloadedUpdate, }
