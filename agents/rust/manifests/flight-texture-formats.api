src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)] pub enum TextureContainerFormat { Rgba8Unorm, Rgba8Srgb, Bgra8Unorm, Bgra8Srgb, R8Unorm, Rg8Unorm, Rgba16f, Rgba32f, Bc1, Bc1Srgb, Bc2, Bc2Srgb, Bc3, Bc3Srgb, Bc4, Bc4Snorm, Bc5, Bc5Snorm, Bc6hUfloat, Bc6hSfloat, Bc7, Bc7Srgb, Etc1, Etc2Rgb, Etc2RgbSrgb, Etc2Rgba, Etc2RgbaSrgb, Etc2RgbA1, Etc2RgbA1Srgb, EacR11, EacR11Snorm, EacRg11, EacRg11Snorm, Pvrtc2bppRgb, Pvrtc2bppRgba, Pvrtc4bppRgb, Pvrtc4bppRgba, Astc4x4, Astc5x4, Astc5x5, Astc6x5, Astc6x6, Astc8x5, Astc8x6, Astc8x8, Astc10x5, Astc10x6, Astc10x8, Astc10x10, Astc12x10, Astc12x12, Etc1s, Uastc, }
