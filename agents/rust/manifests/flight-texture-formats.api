src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)] pub enum TextureContainerParseFailureReason { ContainerUnrecognized, FormatUnsupported, HeaderTruncated, LevelRangeOutOfBounds, StructureInvalid, }
