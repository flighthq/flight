src/types.rs: #[derive(Clone)] pub struct HostMidiPermissionCapability { pub get_permission: Arc<dyn Fn() -> PermissionQueryFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostPermissionsCapability { pub notification: HostNotificationPermissionCapability, pub provider: ProviderRef, pub query_permission: Arc<dyn Fn(PermissionName) -> PermissionQueryFuture + Send + Sync>, pub request_media_access: Arc<dyn Fn(PermissionName) -> PermissionRequestFuture + Send + Sync>, pub request_wake_lock: Arc<dyn Fn() -> PermissionRequestFuture + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPreferencesPersistenceQueryCapability { pub get_persistence: Arc<dyn Fn() -> StoragePersistenceFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostPreferencesPersistenceRequestCapability { pub provider: ProviderRef, pub request_persistence: Arc<dyn Fn() -> StoragePersistenceFuture + Send + Sync>, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PermissionQueryFailureReason { OperationFailed, RuntimeUnavailable, Unsupported, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PermissionQueryReason { BestEffort, Ok, OperationFailed, RuntimeUnavailable, Unsupported, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PermissionRequestFailureReason { NoRequestRoute, OperationFailed, RuntimeUnavailable, Timeout, Unsupported, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PermissionRequestReason { BestEffort, CleanupFailed, Denied, Dismissed, Granted, NoRequestRoute, OperationFailed, RuntimeUnavailable, Timeout, Unsupported, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum PermissionState { Denied, Granted, Prompt, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum StoragePersistenceOutcomeReason { BestEffort, OperationFailed, Persistent, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct PermissionQueryOutcome { pub reason: PermissionQueryReason, pub state: Option<PermissionState>, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct PermissionRequestOutcome { pub reason: PermissionRequestReason, pub state: Option<PermissionState>, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct StoragePersistenceOutcome { pub outcome: StoragePersistenceOutcomeReason, pub permission_state: Option<PermissionState>, }
src/types.rs: #[derive(Clone, Default)] pub struct HostPermissionsCapabilities { pub query: Option<HostPermissionsCapability>, }
