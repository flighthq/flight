src/types.rs: pub type PermissionName = String;
src/types.rs: pub type PermissionQueryFuture = Pin<Box<dyn Future<Output = PermissionQueryProviderResult> + Send>>;
src/types.rs: pub type PermissionQueryProviderResult = Result<PermissionQueryOutcome, FlightError>;
src/types.rs: pub type PermissionRequestFuture = Pin<Box<dyn Future<Output = PermissionRequestProviderResult> + Send>>;
src/types.rs: pub type PermissionRequestProviderResult = Result<PermissionRequestOutcome, FlightError>;
src/types.rs: pub type StoragePersistenceFuture = Pin<Box<dyn Future<Output = StoragePersistenceProviderResult> + Send>>;
src/types.rs: pub type StoragePersistenceProviderResult = Result<StoragePersistenceOutcome, FlightError>;
