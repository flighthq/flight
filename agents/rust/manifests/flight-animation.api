src/types.rs: #[derive(Clone, Debug)] pub struct AnimationClipEvent { pub name: String, pub payload: Payload, pub time: f32, runtime: EntityRuntimeSlot, }
src/types.rs: #[derive(Clone, Debug)] pub struct AnimationCrossfade { pub channels: Vec<AnimationCrossfadeChannel>, pub curve: EasingFn, pub duration: f32, pub elapsed: f32, pub from: AnimationPlayerRef, pub from_sample: Vec<f32>, pub to: AnimationPlayerRef, pub to_sample: Vec<f32>, pub weight: f32, runtime: EntityRuntimeSlot, }
src/types.rs: #[derive(Clone, Debug)] pub struct AnimationCrossfadeChannel { pub channel: AnimationChannel, pub from_index: Option<usize>, pub to_index: Option<usize>, }
src/types.rs: #[derive(Clone, Debug)] pub struct AnimationLayer { pub additive: bool, pub blend_tree: Option<AnimationBlendTreeRef>, pub channel_indices: Option<Vec<usize>>, pub state_machine: Option<AnimationStateMachineRef>, pub weight: f32, runtime: EntityRuntimeSlot, }
src/types.rs: #[derive(Clone, Debug)] pub struct AnimationLayerStack { pub advance_scratch: Vec<AnimationPlayerRef>, pub blend_trees: Vec<AnimationBlendTreeRef>, pub channels: Vec<AnimationLayerStackChannel>, pub layers: Vec<AnimationLayer>, pub sample_scratch: Vec<f32>, pub state_machines: Vec<AnimationStateMachineRef>, runtime: EntityRuntimeSlot, }
