src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] #[repr(u8)] pub enum AnimationInterpolation { Cubic, Linear, Step, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] #[repr(u8)] pub enum AnimationLoopMode { PingPong, Repeat, }
