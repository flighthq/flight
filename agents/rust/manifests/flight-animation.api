src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub struct AnimationLayerStackChannelSource { pub channel_index: usize, pub layer_index: usize, }
src/types.rs: #[derive(Clone, Debug)] pub enum StateRef { Name(String), Index(usize), }
