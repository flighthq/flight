src/velocity_field.rs: #[derive(Debug, Clone, Copy, PartialEq)] pub enum VelocityReason { NoSample, Stale, ExplicitZero, DerivedZero, Ok, }
src/velocity_field.rs: #[derive(Debug, Clone, Copy, PartialEq, Default)] pub struct Velocity2D { pub x: f32, pub y: f32, }
src/velocity_field.rs: #[derive(Debug, Clone, Copy, PartialEq, Default)] pub struct VelocityExplanation { pub current_frame_id: i32, pub explicit: bool, pub last_frame_id: i32, pub reason: VelocityReason, pub x: f32, pub y: f32, }
src/velocity_field.rs: #[derive(Debug, Clone, Default, PartialEq)] pub struct VelocityField { pub frame_id: i32, pub samples: HashMap<SourceId, VelocitySample>, runtime: EntityRuntimeSlot, }
src/velocity_field.rs: #[derive(Debug, Clone, PartialEq, Default)] pub struct VelocitySample { pub previous_world_transform: Option<Matrix>, pub velocity: Velocity2D, pub last_frame_id: i32, pub explicit_frame_id: i32, }
