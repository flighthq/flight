src/types.rs: pub type ScreenChangeListener = Arc<dyn Fn(&ScreenChangeEvent) + Send + Sync>;
src/types.rs: pub type ScreenDetailsRequestFuture = Pin<Box<dyn Future<Output = ScreenDetailsRequestResult> + Send>>;
src/types.rs: pub type ScreenDetailsRequestResult = Result<bool, FlightError>;
src/types.rs: pub type ScreenPermissionFuture = Pin<Box<dyn Future<Output = ScreenPermissionResult> + Send>>;
src/types.rs: pub type ScreenPermissionListener = Arc<dyn Fn(ScreenPermissionState) + Send + Sync>;
src/types.rs: pub type ScreenPermissionResult = Result<ScreenPermissionState, FlightError>;
src/types.rs: pub type ScreenUnsubscribe = Arc<dyn Fn() + Send + Sync>;
