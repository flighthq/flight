src/types.rs: #[derive(Clone)] pub struct HostScreenChangeCapability { pub provider: ProviderRef, pub subscribe: Arc<dyn Fn(ScreenChangeListener) -> ScreenUnsubscribe + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostScreenDetailsCapability { pub provider: ProviderRef, pub query_permission: Arc<dyn Fn() -> ScreenPermissionFuture + Send + Sync>, pub request: Arc<dyn Fn() -> ScreenDetailsRequestFuture + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostScreenPermissionChangeCapability { pub provider: ProviderRef, pub subscribe: Arc<dyn Fn(ScreenPermissionListener) -> ScreenUnsubscribe + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostScreenQueryCapability { pub provider: ProviderRef, pub destroy: Option<Arc<dyn Fn() + Send + Sync>>, pub get_screens: Arc<dyn Fn(&mut Vec<ScreenInfo>) + Send + Sync>, pub get_primary_screen: Arc<dyn Fn(&mut ScreenInfo) + Send + Sync>, pub get_cursor_position: Arc<dyn Fn(&mut Vector2) + Send + Sync>, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum ScreenChangeKind { #[default] ScreenAdded, ScreenMetricsChanged, ScreenRemoved, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum ScreenColorSpace { DisplayP3, Rec2020, #[default] Srgb, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum ScreenOrientation { #[default] Landscape, LandscapeFlipped, Portrait, PortraitFlipped, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum ScreenPermissionState { Denied, Granted, #[default] Prompt, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub struct ScreenChangedMetrics { pub bounds: bool, pub work_area: bool, pub scale_factor: bool, pub orientation: bool, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct ScreenInfo { pub(crate) runtime: EntityRuntimeSlot, pub id: f64, pub x: f32, pub y: f32, pub width: f32, pub height: f32, pub work_width: f32, pub work_height: f32, pub scale_factor: f32, pub is_primary: bool, pub rotation: f32, pub orientation: ScreenOrientation, pub refresh_rate: f32, pub color_depth: f32, pub pixel_depth: f32, pub physical_width: f32, pub physical_height: f32, pub is_hdr: bool, pub color_space: ScreenColorSpace, pub max_luminance: f32, pub depth_per_component: f32, pub dpi: f32, pub label: String, pub internal: bool, pub touch_support: String, pub monochrome: bool, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct ScreenMode { runtime: EntityRuntimeSlot, pub width: f32, pub height: f32, pub refresh_rate: f32, pub color_depth: f32, pub pixel_format: String, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct ScreenChangeEvent { pub kind: ScreenChangeKind, pub screen: ScreenInfo, pub changed_metrics: Option<ScreenChangedMetrics>, }
src/types.rs: #[derive(Clone, Default)] pub struct HostScreenCapabilities { pub change: Option<HostScreenChangeCapability>, pub details: Option<HostScreenDetailsCapability>, pub permission_change: Option<HostScreenPermissionChangeCapability>, pub query: Option<HostScreenQueryCapability>, }
src/types.rs: #[derive(Default)] pub struct ScreenPermissionChange { runtime: EntityRuntimeSlot, pub on_change: Signal<ScreenPermissionState>, pub(crate) subscription: Option<ScreenUnsubscribe>, }
src/types.rs: #[derive(Default)] pub struct ScreenQueryScratch { pub(crate) screens: Vec<ScreenInfo>, }
src/types.rs: #[derive(Default)] pub struct ScreenSignals { runtime: EntityRuntimeSlot, pub on_screen_added: Signal<ScreenInfo>, pub on_screen_metrics_changed: Signal<ScreenChangeEvent>, pub on_screen_removed: Signal<ScreenInfo>, pub(crate) subscription: Option<ScreenUnsubscribe>, }
