src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)] pub enum TextAutoSize { Center, Left, #[default] None, Right, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)] pub enum TextJustification { InterCharacter, #[default] InterWord, None, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)] pub enum TextVerticalAlign { Bottom, Middle, #[default] Top, }
src/types.rs: #[derive(Clone, Debug)] pub struct TextLayoutGroup { runtime: EntityRuntimeSlot, pub ascent: f32, pub descent: f32, pub end_index: usize, pub format: Ref<TextFormat>, pub height: f32, pub leading: f32, pub line_index: usize, pub offset_x: f32, pub offset_y: f32, pub positions: Vec<f32>, pub start_index: usize, pub width: f32, }
