src/types.rs: #[derive(Clone, Debug, Default)] pub struct TextLayoutResult { runtime: EntityRuntimeSlot, pub groups: Vec<TextLayoutGroup>, pub line_ascents: Vec<f32>, pub line_descents: Vec<f32>, pub line_heights: Vec<f32>, pub line_leadings: Vec<f32>, pub line_widths: Vec<f32>, pub num_lines: usize, pub text_height: f32, pub text_width: f32, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct TextMetrics { runtime: EntityRuntimeSlot, pub height: f32, pub num_lines: usize, pub width: f32, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct TextBoundsSpec { pub auto_size: TextAutoSize, pub height: f32, pub width: f32, pub word_wrap: Option<bool>, }
