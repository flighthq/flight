src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum PlatformEndianness { Big, Little, #[default] Unknown, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum PlatformEngine { Gecko, Blink, Webkit, #[default] Unknown, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum PlatformKind { Desktop, Mobile, Web, #[default] Unknown, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum PlatformName { Web, Windows, MacOs, Linux, Ios, Android, #[default] Unknown, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum PlatformRuntime { Web, Electron, Tauri, Capacitor, Native, #[default] Unknown, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct PlatformInfo { entity_runtime: EntityRuntimeSlot, pub name: PlatformName, pub kind: PlatformKind, pub version: String, pub arch: String, pub locale: String, pub is_touch: bool, pub runtime: PlatformRuntime, pub engine: PlatformEngine, pub engine_version: String, pub endianness: PlatformEndianness, pub pointer_width: i32, pub os_build: String, pub distro: String, pub distro_version: String, }
