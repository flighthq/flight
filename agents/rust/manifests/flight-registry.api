src/registry_table.rs: #[derive(Clone, Debug, PartialEq)] pub struct KindMap<T> { pub entries: HashMap<Kind, T>, pub key_order: Vec<Kind>, }
src/registry_table.rs: #[derive(Clone, Debug, PartialEq)] pub struct OrdinalTable<T> { pub entries: Vec<Option<T>>, pub vocabulary: Vec<Kind>, }
src/registry_table.rs: impl OrdinalTable<T> :: fn new(vocabulary: &[Kind]) -> NonEntityCreateResult<Self>
src/registry_table.rs: pub fn concat_kind_map<T: Clone>(base: &KindMap<T>, overlay: &KindMap<T>) -> KindMap<T>
