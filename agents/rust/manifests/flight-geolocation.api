src/types.rs: #[derive(Clone)] pub struct HostGeolocationCapability { pub clear_watch: Arc<dyn Fn(i32) + Send + Sync>, pub get_current_position: Arc<dyn Fn(GeolocationRequestOptions) -> GeolocationPositionFuture + Send + Sync>, pub get_current_position_result: Arc<dyn Fn(GeolocationRequestOptions) -> GeolocationPositionResultFuture + Send + Sync>, pub is_available: Arc<dyn Fn() -> bool + Send + Sync>, pub watch_position: Arc<dyn Fn(Arc<dyn Fn(&GeolocationPosition) + Send + Sync>, GeolocationRequestOptions, Option<Arc<dyn Fn(GeolocationErrorReason) + Send + Sync>>,) -> i32 + Send + Sync,>, pub prompt_for_access: Option<Arc<dyn Fn() -> GeolocationPromptFuture + Send + Sync>>, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum GeolocationAccessReason { CleanupFailed, Denied, Dismissed, Granted, OperationFailed, RuntimeUnavailable, Timeout, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum GeolocationErrorReason { Denied, Timeout, Unavailable, }
src/types.rs: #[derive(Clone, Debug)] pub struct GeolocationPositionResult { pub position: Option<GeolocationPosition>, pub reason: Option<GeolocationErrorReason>, }
src/types.rs: #[derive(Clone, Debug, Default)] pub struct GeolocationPosition { runtime: EntityRuntimeSlot, pub latitude: f32, pub longitude: f32, pub accuracy: f32, pub altitude: f32, pub altitude_accuracy: f32, pub floor_level: f32, pub heading: f32, pub speed: f32, pub timestamp: f64, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct GeolocationRequestOptions { pub enable_high_accuracy: Option<bool>, pub timeout_ms: Option<f64>, pub maximum_age_ms: Option<f64>, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct GeolocationAccessOutcome { pub reason: GeolocationAccessReason, }
src/types.rs: #[derive(Clone, Default)] pub struct HostGeolocationCapabilities { pub position: Option<HostGeolocationCapability>, }
