src/types.rs: #[derive(Clone)] pub enum EffectOperation { Adjustment(Ref<dyn Adjustment>), Effect(EffectRef), }
src/types.rs: #[derive(Clone, Copy, Debug)] pub struct GlEffectRegistration { pub is_resolvable: Option<GlEffectResolver>, pub runner: GlEffectRunner, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq)] pub struct GlEffectBoxBlurOptions { pub blur_x: Option<f32>, pub blur_y: Option<f32>, pub passes: Option<f32>, pub edge_color: Option<[f32; 4]>, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq)] pub struct GlGaussianBlurOptions { pub blur_x: Option<f32>, pub blur_y: Option<f32>, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum GlEffectApplicationStatus { Complete, NoEffects, PartialRegistration, PartialResolution, SourceUnavailable, StaleDestination, UnregisteredEffects, UnresolvedEffects, }
src/types.rs: #[derive(Clone, Debug, Default)] pub struct GlColorLutTextureCache { pub texture: Option<NativeTexture>, pub lut: Option<ColorLut>, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct GlEffectApplicationExplanation { pub registered_count: usize, pub requested_count: usize, pub status: GlEffectApplicationStatus, pub unregistered_kinds: Vec<Kind>, pub unresolved_indexes: Vec<usize>, }
src/types.rs: pub struct GlEffectContext<'a> { pub state: &'a mut GlRenderState, pub source: &'a GlTextureRenderTarget, pub dest: &'a GlTextureRenderTarget, pub pool: &'a mut GlTextureRenderTargetPool, pub scene_depth_texture: Option<NativeTexture>, pub scene_velocity_texture: Option<NativeTexture>, }
src/types.rs: pub struct GlEffectState { pub options: EffectStateOptions, pub scene_target: Option<GlTextureRenderTarget>, pub pool: GlTextureRenderTargetPool, pub lut_cache: ColorLutCache, pub lut_texture: GlColorLutTextureCache, pub velocity_texture: Option<NativeTexture>, }
src/types.rs: pub type GlCustomShaderSourceGuard = Arc<dyn Fn(&GlRenderState, &str, &str, &str) + Send + Sync>;
src/types.rs: pub type GlEffectApplicationGuard = Arc<dyn Fn(&GlRenderState, &GlEffectApplicationExplanation) + Send + Sync>;
src/types.rs: pub type GlEffectResolver = fn(&mut GlRenderState, &dyn Effect) -> bool;
src/types.rs: pub type GlEffectRunner = fn(&mut GlEffectContext<'_>, &dyn Effect) -> Result<(), String>;
src/types.rs: pub type GlEffectStateSkipGuard = Arc<dyn Fn(&GlRenderState, &str) + Send + Sync>;
