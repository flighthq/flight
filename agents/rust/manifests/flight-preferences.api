src/types.rs: #[derive(Clone)] pub struct HostPreferencesCapability { pub clear: Arc<dyn Fn() -> StorageClearResult + Send + Sync>, pub get_item: Arc<dyn Fn(&str) -> StorageGetItemResult + Send + Sync>, pub keys: Arc<dyn Fn() -> StorageKeysResult + Send + Sync>, pub provider: ProviderRef, pub remove_item: Arc<dyn Fn(&str) -> StorageRemoveItemResult + Send + Sync>, pub set_item: Arc<dyn Fn(&str, &str) -> StorageSetItemResult + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostPreferencesChangeCapability { pub destroy: Arc<dyn Fn() + Send + Sync>, pub provider: ProviderRef, pub subscribe: Arc<dyn Fn(Arc<dyn Fn(&StorageChange) + Send + Sync>) -> Option<Arc<dyn Fn() + Send + Sync>> + Send + Sync>, }
src/types.rs: #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)] pub enum StorageClearFailureReason { ClearFailed, QuotaExceeded, RuntimeUnavailable, SecurityDenied, }
src/types.rs: #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)] pub enum StorageClearNamespaceFailureReason { PersistenceInvalid, QuotaExceeded, ReadFailed, RemoveFailed, RuntimeUnavailable, SecurityDenied, }
src/types.rs: #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)] pub enum StorageGetItemFailureReason { PersistenceInvalid, ReadFailed, RuntimeUnavailable, SecurityDenied, }
src/types.rs: #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)] pub enum StorageMigrationReadFailureReason { PersistenceInvalid, ReadFailed, RuntimeUnavailable, SecurityDenied, VersionParseFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)] pub enum StorageReadFailureReason { ParseFailed, PersistenceInvalid, ReadFailed, RuntimeUnavailable, SecurityDenied, }
src/types.rs: #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)] pub enum StorageRemoveItemFailureReason { PersistenceInvalid, QuotaExceeded, ReadFailed, RemoveFailed, RuntimeUnavailable, SecurityDenied, }
src/types.rs: #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)] pub enum StorageSetItemFailureReason { PersistenceInvalid, QuotaExceeded, ReadFailed, RuntimeUnavailable, SecurityDenied, WriteFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)] pub enum StorageWriteFailureReason { PersistenceInvalid, QuotaExceeded, ReadFailed, RuntimeUnavailable, SecurityDenied, SerializationFailed, WriteFailed, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub enum StorageBatchMutationOutcome<F> { Ok(StorageBatchMutationOk), Err(StorageBatchMutationErr<F>), }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub enum StorageFallbackOutcome<V> { Ok(StorageFallbackOk<V>), ParseFailed(StorageFallbackParseFailed<V>), ProviderError(StorageFallbackProviderError), }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub enum StorageMigrationOutcomeInner { Ok(StorageMigrationOk), ReadVersionFailed(StorageMigrationReadVersionFailed), CheckpointFailed(StorageMigrationCheckpointFailed), }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub enum StorageMutationOutcome<F> { Ok, Err(StorageMutationErr<F>), }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub enum StorageQueryOutcome<V> { Ok(StorageQueryOk<V>), Err(StorageQueryErr), }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub enum StorageValueOutcome<V, F> { Ok(StorageValueOk<V>), Err(StorageValueErr<F>), }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageBatchMutationErr<F> { pub completed: usize, pub failed_key: Option<String>, pub reason: F, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageBatchMutationOk { pub completed: usize, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageChange { pub key: Option<String>, pub new_value: Option<String>, pub old_value: Option<String>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageFallbackOk<V> { pub value: V, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageFallbackParseFailed<V> { pub value: V, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageFallbackProviderError { pub reason: StorageGetItemFailureReason, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageMigrationCheckpointFailed { pub failed_version: u32, pub reason: StorageSetItemFailureReason, pub version: u32, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageMigrationOk { pub version: u32, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageMigrationReadVersionFailed { pub reason: StorageMigrationReadFailureReason, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageMutationErr<F> { pub reason: F, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageQueryErr { pub failed_key: Option<String>, pub reason: StorageGetItemFailureReason, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageQueryOk<V> { pub value: V, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageValueErr<F> { pub reason: F, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StorageValueOk<V> { pub value: V, }
