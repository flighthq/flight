src/types.rs: pub type StorageBooleanOrResult = StorageFallbackOutcome<bool>;
src/types.rs: pub type StorageBooleanResult = StorageValueOutcome<Option<bool>, StorageReadFailureReason>;
src/types.rs: pub type StorageByteSizeResult = StorageQueryOutcome<usize>;
src/types.rs: pub type StorageClearNamespaceResult = StorageBatchMutationOutcome<StorageClearNamespaceFailureReason>;
src/types.rs: pub type StorageClearResult = StorageMutationOutcome<StorageClearFailureReason>;
src/types.rs: pub type StorageEntriesResult = StorageQueryOutcome<Vec<(String, String)>>;
src/types.rs: pub type StorageGetItemResult = StorageValueOutcome<Option<String>, StorageGetItemFailureReason>;
src/types.rs: pub type StorageItemCountResult = StorageValueOutcome<usize, StorageGetItemFailureReason>;
src/types.rs: pub type StorageItemOrResult = StorageValueOutcome<String, StorageGetItemFailureReason>;
src/types.rs: pub type StorageItemsResult = StorageQueryOutcome<Vec<Option<String>>>;
src/types.rs: pub type StorageJsonOrResult<T> = StorageFallbackOutcome<Option<T>>;
src/types.rs: pub type StorageJsonResult<T> = StorageValueOutcome<Option<T>, StorageReadFailureReason>;
src/types.rs: pub type StorageJsonWriteResult = StorageMutationOutcome<StorageWriteFailureReason>;
src/types.rs: pub type StorageKeysResult = StorageValueOutcome<Vec<String>, StorageGetItemFailureReason>;
