src/types.rs: #[derive(Clone)] pub struct HostMediaSessionCapability { pub provider: ProviderRef, pub clear_metadata: Arc<dyn Fn() -> MediaSessionClearMetadataOutcome + Send + Sync>, pub clear_position_state: Arc<dyn Fn() -> MediaSessionClearPositionStateOutcome + Send + Sync>, pub destroy: Arc<dyn Fn() + Send + Sync>, pub set_metadata: Arc<dyn Fn(&MediaSessionMetadata) -> MediaSessionSetMetadataOutcome + Send + Sync>, pub set_playback_state: Arc<dyn Fn(MediaSessionPlaybackState) -> MediaSessionSetPlaybackStateOutcome + Send + Sync>, pub set_position_state: Arc<dyn Fn(&MediaSessionPositionState) -> MediaSessionSetPositionStateOutcome + Send + Sync,>, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionAction { Play, Pause, Stop, SeekBackward, SeekForward, SeekTo, PreviousTrack, NextTrack, SkipAd, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionClearMetadataReason { Ok, MediaSessionUnavailable, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionClearPositionStateReason { Ok, MediaSessionUnavailable, PositionStateUnavailable, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionOperationBlockReason { InvalidArtworkSource, InvalidDuration, InvalidPlaybackRate, InvalidPosition, MediaMetadataUnavailable, MediaSessionUnavailable, OperationFailed, PositionStateUnavailable, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionOperationReason { Ok, InvalidArtworkSource, InvalidDuration, InvalidPlaybackRate, InvalidPosition, MediaMetadataUnavailable, MediaSessionUnavailable, OperationFailed, PositionStateUnavailable, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionPlaybackState { None, Paused, Playing, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionSetMetadataReason { Ok, MediaSessionUnavailable, MediaMetadataUnavailable, InvalidArtworkSource, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionSetPlaybackStateReason { Ok, MediaSessionUnavailable, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MediaSessionSetPositionStateReason { Ok, MediaSessionUnavailable, PositionStateUnavailable, InvalidDuration, InvalidPosition, InvalidPlaybackRate, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct MediaSessionOperationOutcome<R = MediaSessionOperationReason> { pub reason: R, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct MediaSessionActionDetails { pub action: MediaSessionAction, pub seek_time: Option<f32>, pub seek_offset: Option<f32>, pub fast_seek: Option<bool>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct MediaSessionPositionState { pub duration: f32, pub playback_rate: f32, pub position: f32, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct MediaSessionArtwork { pub src: String, pub sizes: Option<String>, pub type_: Option<String>, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct MediaSessionMetadata { pub title: String, pub artist: String, pub album: String, pub artwork: Vec<MediaSessionArtwork>, }
src/types.rs: #[derive(Clone, Default)] pub struct HostMediaSessionCapabilities { pub action: Option<HostMediaSessionActionCapability>, pub control: Option<HostMediaSessionCapability>, }
