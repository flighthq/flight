src/types.rs: pub type CommandBindingRef = Arc<CommandBinding>;
src/types.rs: pub type CommandBindingTable = KindMap<CommandBindingRef>;
src/types.rs: pub type CommandExecute = Arc<dyn Fn(&dyn Command) + Send + Sync>;
src/types.rs: pub type CommandMerge = Arc<dyn Fn(&dyn Command, &dyn Command) -> Option<CommandRef> + Send + Sync>;
src/types.rs: pub type CommandPropertyAccessRef = Ref<CommandPropertyAccess>;
src/types.rs: pub type CommandPropertyRead = Arc<dyn Fn(&NodeRef) -> Option<Unknown> + Send + Sync>;
src/types.rs: pub type CommandPropertyWrite = Arc<dyn Fn(&NodeRef, Option<Unknown>) + Send + Sync>;
src/types.rs: pub type CommandRef = Ref<dyn Command>;
