src/types.rs: #[derive(Clone)] pub enum SnapshotValue { Undefined, Null, Bool(bool), Number(f64), String(String), Array(SnapshotArrayRef), Object(SnapshotObjectRef), NonPlain(SnapshotNonPlain), }
src/types.rs: #[derive(Clone)] pub struct SnapshotNonPlain { pub kind: SnapshotNonPlainKind, pub value: Unknown, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)] pub enum SnapshotNonPlainKind { ArrayBuffer, Date, Map, RegExp, Set, TypedArray, }
src/types.rs: #[derive(Clone, Default)] pub struct SnapshotGuardState { pub capture_guard: Option<SnapshotCaptureGuard>, }
src/types.rs: impl fmt::Debug for SnapshotValue
src/types.rs: impl fmt::Debug for SnapshotValue :: fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result
src/types.rs: pub struct SnapshotArray { pub(crate) frozen: bool, pub(crate) items: Vec<SnapshotValue>, }
src/types.rs: pub struct SnapshotObject { pub(crate) entries: Record<SnapshotValue>, pub(crate) frozen: bool, }
src/types.rs: pub type Snapshot = SnapshotValue;
src/types.rs: pub type SnapshotArrayRef = Ref<SnapshotArray>;
src/types.rs: pub type SnapshotCaptureGuard = Arc<dyn Fn(&SnapshotValue) + Send + Sync>;
src/types.rs: pub type SnapshotObjectRef = Ref<SnapshotObject>;
src/types.rs: pub type SnapshotSchema = Vec<String>;
