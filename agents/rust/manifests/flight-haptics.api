src/types.rs: #[derive(Clone)] pub struct HostHapticsCapability { pub cancel: Arc<dyn Fn() -> bool + Send + Sync>, pub capabilities: Arc<dyn Fn(&mut HapticsCapabilities) + Send + Sync>, pub impact: Arc<dyn Fn(HapticImpactStyle, Option<f32>) -> bool + Send + Sync>, pub is_supported: Arc<dyn Fn() -> bool + Send + Sync>, pub notification: Arc<dyn Fn(HapticNotificationType) -> bool + Send + Sync>, pub prepare: Option<Arc<dyn Fn() + Send + Sync>>, pub selection: Arc<dyn Fn() -> bool + Send + Sync>, pub vibrate: Arc<dyn Fn(f32) -> bool + Send + Sync>, pub vibrate_pattern: Arc<dyn Fn(&Vec<f32>) -> bool + Send + Sync>, pub vibrate_waveform: Option<Arc<dyn Fn(&Vec<f32>, &Vec<f32>, Option<i32>) -> bool + Send + Sync>>, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub struct HapticsCapabilities { pub amplitude_control: bool, pub custom_events: bool, pub intensity: bool, pub patterns: bool, pub supported: bool, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] #[repr(u8)] pub enum HapticImpactStyle { Light = 0, Medium = 1, Heavy = 2, Soft = 3, Rigid = 4, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] #[repr(u8)] pub enum HapticNotificationType { Success = 0, Warning = 1, Error = 2, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] #[repr(u8)] pub enum HapticsOperation { Cancel = 0, Capabilities = 1, Impact = 2, IsSupported = 3, Notification = 4, Prepare = 5, Selection = 6, Vibrate = 7, VibratePattern = 8, VibrateWaveform = 9, }
