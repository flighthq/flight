src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum AudioChannelState { Complete, Paused, Playing, #[default] Stopped, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum AudioResourceFailureKind { #[default] Error, Unavailable, }
src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)] pub enum AudioResourceReferenceKind { #[default] Embedded, External, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq)] pub struct AudioPlayOptions { pub current_time: Option<f32>, pub gain: Option<f32>, pub loops: Option<i32>, pub playback_rate: Option<f32>, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct AudioResourceUrl { pub url: String, pub type_: Option<String>, }
src/types.rs: #[derive(Clone, Default)] pub struct AudioResourceFailure { pub kind: AudioResourceFailureKind, pub message: String, pub name: Option<String>, runtime: EntityRuntimeSlot, }
src/types.rs: #[derive(Clone, Default)] pub struct HostAudioDecodeCapabilities { pub aac: Option<HostAudioDecodeFormatCapability>, pub flac: Option<HostAudioDecodeFormatCapability>, pub mp3: Option<HostAudioDecodeFormatCapability>, pub mp4: Option<HostAudioDecodeFormatCapability>, pub ogg: Option<HostAudioDecodeFormatCapability>, pub wav: Option<HostAudioDecodeFormatCapability>, pub webm: Option<HostAudioDecodeFormatCapability>, }
