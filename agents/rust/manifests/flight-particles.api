src/types.rs: #[derive(Clone, Copy, Debug, PartialEq)] pub enum ParticleBlendMode { Add, Multiply, Normal, Screen, }
src/types.rs: #[derive(Clone, Debug)] pub enum ParticleCollider { PlaneCollider { nx: f32, ny: f32, nz: f32, distance: f32, restitution: f32, friction: f32, }, CircleCollider { x: f32, y: f32, radius: f32, mode: ColliderMode, restitution: f32, friction: f32, }, RectangleCollider { x: f32, y: f32, width: f32, height: f32, mode: ColliderMode, restitution: f32, friction: f32, }, SphereCollider { x: f32, y: f32, z: f32, radius: f32, mode: ColliderMode, restitution: f32, friction: f32, }, }
src/types.rs: #[derive(Clone, Debug)] pub enum ParticleForce { WindForce { x: f32, y: f32, z: f32, }, DragForce { strength: f32, }, AttractorForce { x: f32, y: f32, z: f32, strength: f32, falloff: Option<ForceFalloff>, radius: Option<f32>, }, VortexForce { x: f32, y: f32, z: f32, strength: f32, falloff: Option<ForceFalloff>, radius: Option<f32>, axis_x: f32, axis_y: f32, axis_z: f32, }, TurbulenceForce { strength: f32, scale: f32, }, }
