src/log.rs: pub type LogDataProvider = Arc<dyn Fn() -> LogData + Send + Sync>;
src/log.rs: pub type LogFormatter = Arc<dyn Fn(&LogEntry) -> String + Send + Sync>;
src/log.rs: pub type LogPredicate = Arc<dyn Fn(&LogEntry) -> bool + Send + Sync>;
src/log.rs: pub type LogSerializer = Arc<dyn Fn(&HashMap<String, LogValue>) -> HashMap<String, LogValue> + Send + Sync>;
src/log.rs: pub type LogSink = Arc<dyn Fn(&LogEntry) + Send + Sync>;
src/log.rs: pub type LogStateRef = Ref<LogState>;
