src/contract.rs: pub use crate::log::*;
src/lib.rs: pub mod contract
src/lib.rs: pub use contract::*;
src/log.rs: #[derive(Clone)] pub enum LogValue { Null, Bool(bool), Int(i64), Float(f64), Str(String), Record(HashMap<String, LogValue>), Array(Vec<LogValue>), Object(flight_entity::UnknownValue), }
src/log.rs: #[derive(Clone)] pub struct BufferedLogSink { pub sink: LogSink, state: Arc<Mutex<BufferedLogSinkState>>, runtime: EntityRuntimeSlot, }
src/log.rs: #[derive(Clone)] pub struct LogSignals { pub on_log_entry: Signal<LogEntry>, pub on_log_error: Signal<LogEntry>, runtime: EntityRuntimeSlot, }
src/log.rs: #[derive(Clone)] pub struct MemoryLogSink { pub sink: LogSink, state: Arc<Mutex<MemoryLogSinkState>>, runtime: EntityRuntimeSlot, }
src/log.rs: #[derive(Clone)] pub struct RateLimitedLogSink { pub sink: LogSink, runtime: EntityRuntimeSlot, }
src/log.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)] #[repr(u8)] pub enum LogLevel { None = 0, Error = 1, Warn = 2, Info = 3, Debug = 4, Verbose = 5, }
src/log.rs: #[derive(Clone, Debug)] pub enum LogData { Message(String), Record(HashMap<String, LogValue>), }
src/log.rs: #[derive(Clone, Debug)] pub struct LogContext { pub channel: Option<String>, pub fields: HashMap<String, LogValue>, runtime: EntityRuntimeSlot, }
src/log.rs: #[derive(Clone, Debug)] pub struct LogEntry { pub level: LogLevel, pub channel: Option<String>, pub data: LogData, pub timestamp_ms: f64, }
src/log.rs: #[derive(Clone, Debug)] pub struct LogSpan { pub id: u64, pub name: String, pub channel: Option<String>, pub fields: HashMap<String, LogValue>, runtime: EntityRuntimeSlot, }
src/log.rs: #[derive(Clone, Debug)] pub struct LogTimer { pub label: String, pub channel: Option<String>, pub started_at: f64, }
src/log.rs: #[derive(Clone, Debug)] pub struct RateLimitedLogSinkOptions { pub per_channel: bool, pub max_per_interval: usize, pub interval_ms: f64, }
src/log.rs: #[derive(Clone, Debug, Default)] pub struct BufferedLogSinkOptions { pub size: Option<usize>, pub interval_ms: Option<f64>, }
src/log.rs: #[derive(Clone, Debug, Default)] pub struct TextLogFormatterOptions { pub indent_groups: Option<bool>, pub level_prefix: Option<bool>, pub timestamp: Option<bool>, }
