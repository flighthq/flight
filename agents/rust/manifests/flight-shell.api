src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShellExternalReason { BlockedScheme, Ok, OperationFailed, PopupBlocked, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShellPathOpenReason { Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShellPathRevealReason { Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShellShortcutLinkReadReason { Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShellShortcutLinkWriteReason { Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShellShortcutWriteOperation { Create, Replace, Update, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum ShellTrashReason { Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct ShellExternalOutcome { pub reason: ShellExternalReason, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct ShellPathOpenOutcomeOk { }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct ShellPathRevealOutcome { pub reason: ShellPathRevealReason, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct ShellShortcutLinkWriteOutcome { pub reason: ShellShortcutLinkWriteReason, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct ShellTrashOutcome { pub reason: ShellTrashReason, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct ShellExternalUrlPolicy { pub allowed_schemes: Vec<String>, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct ShellProcessExitStatus { pub code: Option<i32>, pub signal: Option<String>, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct ShellProcessOptions { pub cwd: Option<String>, pub environment: Option<HashMap<String, String>>, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct ShellShortcutLink { pub target: String, pub app_user_model_id: Option<String>, pub args: Option<String>, pub description: Option<String>, pub icon: Option<String>, pub icon_index: Option<i32>, pub working_directory: Option<String>, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub enum ShellPathOpenOutcome { Ok(ShellPathOpenOutcomeOk), OperationFailed(ShellPathOpenOutcomeOperationFailed), }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub enum ShellShortcutLinkReadOutcome { Ok(ShellShortcutLinkReadOutcomeOk), OperationFailed(ShellShortcutLinkReadOutcomeOperationFailed), }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct ShellPathOpenOutcomeOperationFailed { pub message: String, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct ShellShortcutLinkReadOutcomeOk { pub link: ShellShortcutLink, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct ShellShortcutLinkReadOutcomeOperationFailed { pub message: String, }
src/types.rs: #[derive(Clone, Default)] pub struct HostShellCapabilities { pub beep: Option<HostShellBeepCapability>, pub external: Option<HostShellExternalCapability>, pub path_open: Option<HostShellPathOpenCapability>, pub path_reveal: Option<HostShellPathRevealCapability>, pub process: Option<HostShellProcessCapability>, pub shortcut_link: Option<HostShellShortcutLinkCapability>, pub trash: Option<HostShellTrashCapability>, }
