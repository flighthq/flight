src/types.rs: #[derive(Clone)] pub struct HostSocketCapability { pub provider: ProviderRef, pub open_socket: Arc<dyn Fn(&SocketOptions, &SocketEventSink) -> Option<SocketConnection> + Send + Sync>, pub open_tcp_socket: Option<Arc<dyn Fn(&TcpSocketOptions) -> Option<TcpSocketConnection> + Send + Sync>>, }
src/types.rs: #[derive(Clone)] pub struct SocketConnection { pub send_socket_frame: Arc<dyn Fn(&SocketMessageData) -> bool + Send + Sync>, pub close_socket_connection: Arc<dyn Fn(Option<i32>, Option<&str>) + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct SocketEventSink { pub handle_socket_open: Arc<dyn Fn() + Send + Sync>, pub handle_socket_message: Arc<dyn Fn(&SocketMessage) + Send + Sync>, pub handle_socket_close: Arc<dyn Fn(&SocketCloseInfo) + Send + Sync>, pub handle_socket_error: Arc<dyn Fn() + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct SocketGuardNotice { pub operation: SocketGuardOperation, pub reason: SocketGuardReason, pub socket: Ref<Socket>, }
src/types.rs: #[derive(Clone)] pub struct SocketRuntime { pub connection: Option<SocketConnection>, pub signals: Option<Ref<SocketSignals>>, pub ready_state: SocketReadyState, pub delivering: bool, pub disposed: bool, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum SocketBinaryType { ArrayBuffer, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum SocketGuardOperation { CreateSocket, CloseSocket, EnableSocketSignals, SendSocketMessage, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum SocketGuardReason { NoConnection, Disposed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum SocketReadyState { Connecting, Open, Closing, Closed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum SocketSendFailureReason { Disposed, NoConnection, NotOpen, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct SocketOptions { pub url: String, pub protocols: Option<Vec<String>>, pub binary_type: Option<SocketBinaryType>, }
src/types.rs: #[derive(Clone, Debug, Default, PartialEq, Eq)] pub struct TcpSocketOptions { pub host: String, pub port: i32, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub enum SocketMessageData { Text(String), Binary(Box<Uint8Array>), }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct SocketCloseInfo { pub code: i32, pub reason: String, pub was_clean: bool, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct SocketMessage { pub data: SocketMessageData, pub binary: bool, }
src/types.rs: #[derive(Clone, Debug, PartialEq, Eq)] pub struct SocketSendFailureExplanation { pub reason: SocketSendFailureReason, pub ready_state: SocketReadyState, pub url: String, }
src/types.rs: #[derive(Clone, Default)] pub struct HostSocketCapabilities { pub connection: Option<HostSocketCapability>, }
src/types.rs: #[derive(Default)] pub struct Socket { runtime: EntityRuntimeSlot, pub url: String, }
src/types.rs: #[derive(Default)] pub struct SocketGuardState { pub guard: Option<SocketGuard>, pub enabled: bool, }
src/types.rs: #[derive(Default)] pub struct SocketSignals { runtime: EntityRuntimeSlot, pub on_socket_open: Signal<()>, pub on_socket_message: Signal<SocketMessage>, pub on_socket_close: Signal<SocketCloseInfo>, pub on_socket_error: Signal<()>, }
