src/types.rs: #[derive(Clone)] pub struct HostShareFilesCapability { pub provider: ProviderRef, pub can_share_content: Arc<dyn Fn(Ref<ShareFilesContent>) -> bool + Send + Sync>, pub share_content: Arc<dyn Fn(Ref<ShareFilesContent>) -> ShareBoolFuture + Send + Sync>, pub share_content_with_result: Arc<dyn Fn(Ref<ShareFilesContent>) -> ShareResultFuture + Send + Sync>, }
