src/types.rs: #[derive(Clone, Copy, Debug, Default, PartialEq)] pub struct StatechartStateChangeEvent { pub region_index: i32, pub previous_state_index: i32, pub state_index: i32, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum StatechartComparison { Equal, GreaterThan, GreaterThanOrEqual, LessThan, LessThanOrEqual, NotEqual, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum StatechartInputKind { Boolean, Number, Trigger, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum StatechartTransitionStatus { ConditionsUnmet, ExitTimePending, InvalidRegion, MissingRegionDuration, NoTransitions, Ready, Transitioning, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct Statechart { pub inputs: Vec<StatechartInput>, pub name: Option<String>, pub regions: Vec<StatechartRegion>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StatechartCondition { pub comparison: StatechartComparison, pub input_index: i32, pub value: f64, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StatechartInput { pub initial_value: f64, pub kind: StatechartInputKind, pub name: Option<String>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StatechartRegion { pub initial_state_index: i32, pub name: Option<String>, pub states: Vec<StatechartState>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StatechartState { pub kind: String, pub name: Option<String>, pub transitions: Vec<StatechartTransition>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StatechartTransition { pub conditions: Vec<StatechartCondition>, pub duration_ms: f64, pub exit_time_ratio: f64, pub target_state_index: i32, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct StatechartTransitionExplanation { pub blend: f32, pub condition_index: i32, pub region_index: i32, pub source_state_index: i32, pub status: StatechartTransitionStatus, pub target_state_index: i32, pub transition_index: i32, }
