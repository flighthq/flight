src/types.rs: #[derive(Clone)] pub struct HostNotificationActionCapability { pub attach: Arc<dyn Fn(NotificationActionListener) -> NotificationEventBackendAttachFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationActiveListCapability { pub get_active_notifications: Arc<dyn Fn() -> NotificationActiveListFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationClickCapability { pub attach: Arc<dyn Fn(NotificationClickListener) -> NotificationEventBackendAttachFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationCloseCapability { pub close_all_notifications: Arc<dyn Fn() -> NotificationLifecycleFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationDeliveryCapability { pub notify: Arc<dyn Fn(&NotificationRequest) -> NotificationDeliveryFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationDismissCapability { pub attach: Arc<dyn Fn(NotificationDismissListener) -> NotificationEventBackendAttachFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationLifecycleCapability { pub destroy: Arc<dyn Fn() -> NotificationLifecycleFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationPermissionCapability { pub get_permission: Arc<dyn Fn() -> NotificationPermissionQueryFuture + Send + Sync>, pub request_permission: Arc<dyn Fn() -> NotificationPermissionRequestFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationReceivedCapability { pub attach: Arc<dyn Fn(NotificationReceivedListener) -> NotificationEventBackendAttachFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationReplyCapability { pub attach: Arc<dyn Fn(NotificationReplyListener) -> NotificationEventBackendAttachFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct HostNotificationSchedulingCapability { pub cancel_all_scheduled_notifications: Arc<dyn Fn() -> NotificationLifecycleFuture + Send + Sync>, pub get_pending_notifications: Arc<dyn Fn() -> NotificationPendingListFuture + Send + Sync>, pub schedule_notification: Arc<dyn Fn(&NotificationRequest, &NotificationSchedule) -> NotificationScheduleFuture + Send + Sync>, pub provider: ProviderRef, }
src/types.rs: #[derive(Clone)] pub struct NotificationEventAttachment { pub release: Arc<dyn Fn() -> NotificationEventReleaseFuture + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct NotificationEventBackendAttachResult { pub reason: NotificationSubscriptionAttachReason, pub attachment: Option<NotificationEventAttachment>, pub release_failed: Option<bool>, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationCancelReason { AlreadyCancelled, Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationCloseReason { AlreadyClosed, Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationDeliveryReason { Accepted, InvalidRequest, OperationFailed, PermissionDenied, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationDirection { Auto, Ltr, Rtl, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationEventReleaseReason { Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationLifecycleFailureOperation { Cancel, Close, Release, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationLifecycleReason { AlreadyDestroyed, Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationPermission { Default, Denied, Granted, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationPermissionRequestReason { Denied, Dismissed, Granted, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationSchedulePrecision { Exact, Inexact, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationScheduleReason { InvalidSchedule, OperationFailed, PermissionDenied, Scheduled, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationScheduleRepeat { Day, Hour, Minute, Month, Week, Year, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationSubscriptionAttachReason { Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationSubscriptionDetachReason { NotAttached, Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum NotificationSubscriptionDisposeReason { AlreadyDisposed, Ok, OperationFailed, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub struct NotificationRequestField(pub &'static str);
src/types.rs: #[derive(Clone, Debug)] pub struct NotificationActiveListOutcome { pub reason: NotificationLifecycleReason, pub notifications: Option<Vec<Notification>>, }
src/types.rs: #[derive(Clone, Debug)] pub struct NotificationDeliveryOutcome { pub reason: NotificationDeliveryReason, pub notification: Option<Notification>, pub fields: Option<Vec<NotificationRequestField>>, }
src/types.rs: #[derive(Clone, Debug)] pub struct NotificationPendingListOutcome { pub reason: NotificationLifecycleReason, pub notifications: Option<Vec<ScheduledNotification>>, }
src/types.rs: #[derive(Clone, Debug)] pub struct NotificationRequest { pub title: String, pub id: Option<String>, pub body: Option<String>, pub icon: Option<String>, pub badge: Option<String>, pub tag: Option<String>, pub silent: Option<bool>, pub actions: Option<Vec<NotificationAction>>, pub dir: Option<NotificationDirection>, pub image: Option<String>, pub lang: Option<String>, pub renotify: Option<bool>, pub require_interaction: Option<bool>, pub timestamp: Option<f32>, pub vibrate: Option<Vec<f32>>, pub data: Option<Unknown>, }
src/types.rs: #[derive(Clone, Debug)] pub struct NotificationScheduleOutcome { pub reason: NotificationScheduleReason, pub precision: Option<NotificationSchedulePrecision>, pub scheduled: Option<ScheduledNotification>, pub fields: Option<Vec<NotificationRequestField>>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct NotificationAction { pub id: String, pub title: String, pub icon: Option<String>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct NotificationCancelOutcome { pub reason: NotificationCancelReason, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct NotificationCloseOutcome { pub reason: NotificationCloseReason, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct NotificationLifecycleFailure { pub id: String, pub operation: NotificationLifecycleFailureOperation, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct NotificationLifecycleOutcome { pub reason: NotificationLifecycleReason, pub failures: Option<Vec<NotificationLifecycleFailure>>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct NotificationPermissionQueryOutcome { pub reason: NotificationLifecycleReason, pub permission: Option<NotificationPermission>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct NotificationSchedule { pub at: f32, pub repeat: Option<NotificationScheduleRepeat>, }
src/types.rs: #[derive(Clone, Debug, PartialEq)] pub struct NotificationSubscriptionAttachOutcome { pub reason: NotificationSubscriptionAttachReason, pub attach_failed: Option<bool>, pub release_failed: Option<bool>, }
