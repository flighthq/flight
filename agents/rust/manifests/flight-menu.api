src/types.rs: #[derive(Clone)] pub struct HostMenuHighlightCapability { pub subscribe: MenuSubscribe, }
src/types.rs: #[derive(Clone)] pub struct HostMenuPopupCapability { pub popup: Arc<dyn Fn(Vec<Ref<MenuItemTemplate>>, f32, f32) -> MenuPopupFuture + Send + Sync>, }
src/types.rs: #[derive(Clone)] pub struct HostMenuSelectCapability { pub subscribe: MenuSubscribe, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum MenuItemType { Normal, Separator, Submenu, Checkbox, Radio, }
src/types.rs: #[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum WellKnownMenuItemRoleValue { Copy, Cut, Delete, Paste, PasteAndMatchStyle, Redo, SelectAll, ToggleSpellChecker, Undo, About, Close, Front, Hide, HideOthers, MergeAllWindows, Minimize, MoveTabToNewWindow, Quit, SelectNextTab, SelectPreviousTab, ToggleTabBar, Unhide, Zoom, ForceReload, Reload, ResetZoom, ToggleDevTools, ToggleFullscreen, ZoomIn, ZoomOut, Help, Services, StartSpeaking, StopSpeaking, ClearRecentDocuments, RecentDocuments, AppMenu, EditMenu, FileMenu, HelpMenu, ShareMenu, ViewMenu, WindowMenu, }
src/types.rs: #[derive(Clone, Default)] pub struct HostMenuCapabilities { pub app: Option<Ref<HostAppMenuCapability>>, pub highlight: Option<HostMenuHighlightCapability>, pub popup: Option<HostMenuPopupCapability>, pub select: Option<HostMenuSelectCapability>, }
src/types.rs: #[derive(Default)] pub struct AppMenuDestroyedProviders { pub released: Vec<AppMenuProviderWeak>, }
src/types.rs: #[derive(Default)] pub struct MenuHighlight { runtime: EntityRuntimeSlot, pub on_menu_item_highlight: Signal<String>, }
src/types.rs: #[derive(Default)] pub struct MenuItemTemplate { pub id: Option<String>, pub label: Option<String>, pub type_: Option<MenuItemType>, pub role: Option<MenuItemRole>, pub accelerator: Option<String>, pub enabled: Option<bool>, pub checked: Option<bool>, pub visible: Option<bool>, pub sublabel: Option<String>, pub tool_tip: Option<String>, pub submenu: Option<Vec<Ref<MenuItemTemplate>>>, }
src/types.rs: #[derive(Default)] pub struct MenuSelect { runtime: EntityRuntimeSlot, pub on_menu_item_select: Signal<String>, }
src/types.rs: #[derive(Default)] pub struct MenuSignals { runtime: EntityRuntimeSlot, pub on_context_menu_close: Signal<()>, pub on_context_menu_open: Signal<()>, }
src/types.rs: #[derive(Default)] pub struct MenuSignalsState { pub signals: Option<Ref<MenuSignals>>, }
