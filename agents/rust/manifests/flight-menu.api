src/types.rs: pub type AppMenuProviderWeak = Weak<RwLock<HostAppMenuCapability>>;
src/types.rs: pub type MenuItemRole = String;
src/types.rs: pub type MenuPopupFuture = Pin<Box<dyn Future<Output = MenuPopupResult> + Send>>;
src/types.rs: pub type MenuPopupResult = Result<Option<String>, FlightError>;
src/types.rs: pub type MenuSubscribe = Arc<dyn Fn(Arc<dyn Fn(&str) + Send + Sync>) -> MenuUnsubscribe + Send + Sync>;
src/types.rs: pub type MenuUnsubscribe = Arc<dyn Fn() + Send + Sync>;
