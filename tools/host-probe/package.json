{
  "name": "@flighthq/tool-host-probe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#host-probe/*": "./src/*.ts"
  },
  "scripts": {
    "build": "npm run build:web",
    "build:capacitor": "cross-env VITE_HOST_PROBE_HOST=capacitor vite build --config vite.config.ts",
    "build:electron": "electron-vite build --config vite.electron.config.ts",
    "build:capacitor:android": "npm run build:capacitor && tsx scripts/prepareCapacitor.ts android",
    "build:capacitor:ios": "npm run build:capacitor && tsx scripts/prepareCapacitor.ts ios",
    "build:tauri": "tauri build --config src-tauri/tauri.conf.json",
    "build:tauri:frontend": "cross-env VITE_HOST_PROBE_HOST=tauri vite build --config vite.config.ts",
    "build:web": "cross-env VITE_HOST_PROBE_HOST=web vite build --config vite.config.ts",
    "dev": "npm run dev:web",
    "dev:capacitor": "cross-env VITE_HOST_PROBE_HOST=capacitor vite --config vite.config.ts --host 127.0.0.1 --port 4175 --strictPort",
    "dev:capacitor:android": "npm run build:capacitor:android && cap run android",
    "dev:capacitor:ios": "npm run build:capacitor:ios && cap run ios",
    "dev:electron": "electron-vite dev --config vite.electron.config.ts",
    "dev:tauri": "tauri dev --config src-tauri/tauri.conf.json",
    "dev:tauri:frontend": "cross-env VITE_HOST_PROBE_HOST=tauri vite --config vite.config.ts --host 127.0.0.1 --port 4175 --strictPort",
    "dev:web": "cross-env VITE_HOST_PROBE_HOST=web vite --config vite.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e:capacitor:android": "tsx scripts/buildCapacitorApp.ts android && cross-env HOST_PROBE_CAPACITOR_PLATFORM=android wdio run wdio.capacitor.conf.ts",
    "test:e2e:capacitor:ios": "tsx scripts/buildCapacitorApp.ts ios && cross-env HOST_PROBE_CAPACITOR_PLATFORM=ios wdio run wdio.capacitor.conf.ts",
    "test:e2e:electron": "tsx scripts/testElectron.ts",
    "test:e2e:tauri": "npm run build:tauri && wdio run wdio.tauri.conf.ts",
    "test:e2e:web": "tsx scripts/testWeb.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/dialog": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@flighthq/host-capacitor": "*",
    "@flighthq/host-electron": "*",
    "@flighthq/host-tauri": "*",
    "@flighthq/host-web": "*",
    "@flighthq/types": "*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-os": "^2.3.0",
    "@tauri-apps/plugin-process": "^2.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.0.0",
    "@playwright/test": "*",
    "@tauri-apps/cli": "^2.11.4",
    "@wdio/appium-service": "^9.29.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/native-types": "^2.5.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "@wdio/types": "^9.29.1",
    "appium": "^3.7.0",
    "electron": "^31.0.0",
    "electron-vite": "^2.3.0",
    "vite": "*"
  }
}
