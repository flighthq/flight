{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flight Host Probe",
  "version": "0.0.1",
  "identifier": "dev.flighthq.hostprobe",
  "build": {
    "beforeBuildCommand": "npm run build:tauri:frontend",
    "beforeDevCommand": "npm run dev:tauri:frontend",
    "devUrl": "http://127.0.0.1:4175/?host=tauri",
    "frontendDist": "../dist/tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["default"]
    },
    "windows": [
      {
        "height": 760,
        "label": "main",
        "title": "Flight Host Probe",
        "width": 960
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
