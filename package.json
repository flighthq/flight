{
  "name": "flight",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight.git"
  },
  "type": "module",
  "workspaces": [
    "packages/**",
    "examples/**",
    "tools/*"
  ],
  "scripts": {
    "api": "tsx ./scripts/api.ts",
    "api:check": "tsx ./scripts/api.ts --check",
    "api:contract": "tsx ./scripts/api.ts --contract",
    "api:curate": "tsx ./scripts/curate-public-api.ts",
    "api:json": "tsx ./scripts/api.ts --json",
    "assets": "tsx ./scripts/warm-assets.ts",
    "backend-prefix:check": "tsx ./scripts/backendPrefix.ts --check",
    "benchmark:functional": "tsx ./packages/tool-capture/src/bin.ts benchmark --tool=functional --renderer=dom,canvas,webgl,webgpu --benchmark-reference=canvas",
    "benchmark:functional:baseline": "npm run benchmark:functional -- --update-benchmarks",
    "build": "tsc -b tsconfig.build.json",
    "build:check": "npm run packages:check && npm run typecheck",
    "build:clean": "npm run clean && npm run build",
    "build:electron-harness": "npm run build:examples:electron",
    "build:examples": "npm run build --workspace=@flighthq/examples",
    "build:examples:electron": "npm run build --workspace=@flighthq/examples-electron",
    "build:examples:packages": "npm run build --workspace=examples/packages/**",
    "build:functional": "npm run build --workspace=tools/functional",
    "capabilities": "tsx ./scripts/swf-capabilities.ts",
    "capabilities:check": "tsx ./scripts/swf-capabilities.ts --check",
    "capabilities:default-collisions": "tsx ./scripts/swf-default-collision.ts",
    "capabilities:individuation": "tsx ./scripts/swf-individuation.ts",
    "capabilities:numbers": "tsx ./scripts/swf-doc-numbers.ts",
    "capabilities:silent-drops": "tsx ./scripts/swf-silent-drop-shape.ts",
    "capabilities:sites": "tsx ./scripts/swf-diagnostic-sites.ts",
    "capabilities:sites:check": "tsx ./scripts/swf-diagnostic-sites.ts --check",
    "capabilities:tag-census": "tsx ./scripts/swf-tag-census.ts",
    "capabilities:tag-dispatch": "tsx ./scripts/swf-tag-dispatch.ts",
    "capture:baseline": "npm run capture:examples:baseline && npm run capture:functional:baseline",
    "capture:check": "npm run capture:examples:check && npm run capture:functional:check",
    "capture:examples": "tsx ./packages/tool-capture/src/bin.ts capture --tool=examples",
    "capture:examples:baseline": "tsx ./packages/tool-capture/src/bin.ts capture --tool=examples --update-baseline",
    "capture:examples:check": "tsx ./packages/tool-capture/src/bin.ts capture --tool=examples --fail-on-changed",
    "capture:examples:watch": "tsx ./scripts/watch-capture.ts --tool=examples",
    "capture:functional": "tsx ./packages/tool-capture/src/bin.ts capture --tool=functional",
    "capture:functional:baseline": "tsx ./packages/tool-capture/src/bin.ts capture --tool=functional --update-baseline",
    "capture:functional:check": "tsx ./packages/tool-capture/src/bin.ts capture --tool=functional --fail-on-changed",
    "capture:functional:watch": "tsx ./scripts/watch-capture.ts --tool=functional",
    "capture:provenance": "tsx ./scripts/capture-provenance-census.ts",
    "catalog": "tsx ./scripts/catalog.ts",
    "catalog:check": "tsx ./scripts/catalog.ts --check",
    "check": "tsx ./scripts/check.ts",
    "check:append-only-ledgers": "tsx ./scripts/check-append-only-ledgers.ts",
    "check:documented-commands": "tsx ./scripts/check-documented-commands.ts",
    "check:expected-image-descriptions": "tsx ./scripts/check-expected-image-descriptions.ts",
    "check:fingerprint-source-hashes": "tsx ./scripts/check-fingerprint-source-hashes.ts",
    "check:import-conformance": "tsx ./conformance/core/check-import-conformance-ratchet.ts",
    "check:license-provenance": "tsx ./scripts/check-license-provenance.ts",
    "check:package-dist-orphans": "tsx ./scripts/check-package-dist-orphans.ts",
    "clean": "npm run clean:build",
    "clean:build": "tsx ./scripts/clean-package-dist.ts && tsc -b tsconfig.build.json --clean",
    "clean:examples": "npm run clean --workspace=examples/packages/** --if-present",
    "conformance": "tsx ./conformance/core/import-conformance.ts",
    "conformance:fixtures": "tsx ./conformance/fixtures/import-fixture-conformance.ts",
    "contrast": "tsx ./scripts/capture-contrast.ts",
    "contrast:json": "tsx ./scripts/capture-contrast.ts --json",
    "dev:electron-harness": "npm run dev --workspace=@flighthq/examples-electron",
    "dev:examples": "npm run dev:examples:web",
    "dev:examples:electron": "tsx ./scripts/electron-tool.ts examples",
    "dev:examples:web": "npm run dev --workspace=@flighthq/examples",
    "dev:functional": "npm run dev --workspace=tools/functional",
    "dev:review": "npm run dev --workspace=tools/review",
    "docs:check": "tsx ./scripts/docs.ts --check",
    "electron-harness": "npm run dev:electron-harness",
    "electron:examples": "npm run examples:electron",
    "electron:review": "tsx ./scripts/electron-tool.ts review",
    "electron:review:examples": "tsx ./scripts/electron-tool.ts review:examples",
    "electron:review:functional": "tsx ./scripts/electron-tool.ts review:functional",
    "evidence": "tsx ./scripts/capture-evidence.ts",
    "evidence:baseline": "tsx ./scripts/capture-evidence.ts --update",
    "evidence:check": "tsx ./scripts/capture-evidence.ts --check",
    "evidence:json": "tsx ./scripts/capture-evidence.ts --json",
    "examples": "npm run dev:examples",
    "examples:electron": "npm run dev:examples:electron",
    "examples:web": "npm run dev:examples:web",
    "exports:check": "tsx ./scripts/completeness.ts",
    "exports:check:json": "tsx ./scripts/completeness.ts --json",
    "facets": "tsx ./scripts/requirement-facets.ts",
    "facets:check": "tsx ./scripts/requirement-facets.ts --check",
    "fix": "tsx ./scripts/fix.ts",
    "fixtures": "tsx ./scripts/fixtures.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "functional": "npm run dev:functional",
    "hermeticity": "tsx ./scripts/handRolledHermeticity.ts",
    "import-diagnostic-origins": "tsx ./scripts/import-diagnostic-origins.ts",
    "import:conformance:index": "tsx ./conformance/swf/swf-capability-index.ts",
    "instrumentation": "tsx ./scripts/swf-instrumentation.ts",
    "instrumentation:check": "tsx ./scripts/swf-instrumentation.ts --check",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "mocks": "tsx ./scripts/mocks.ts",
    "mocks:check": "tsx ./scripts/mocks.ts --check",
    "mocks:json": "tsx ./scripts/mocks.ts --json",
    "oracle:woff2-reversal": "tsx ./conformance/font/woff2-reversal-oracle.ts",
    "order": "tsx ./scripts/order.ts",
    "order:check": "tsx ./scripts/order.ts --check",
    "order:check:json": "tsx ./scripts/order.ts --check --json",
    "order:fix": "tsx ./scripts/order.ts --fix",
    "packages:check": "tsx ./scripts/packages.ts",
    "packages:check:json": "tsx ./scripts/packages.ts --json",
    "portable": "tsx ./scripts/portable.ts",
    "portable:check": "tsx ./scripts/portable.ts --check",
    "portable:json": "tsx ./scripts/portable.ts --json",
    "precommit": "npm run check:package-dist-orphans && npm run check:license-provenance && lint-staged --no-stash",
    "prepare": "husky",
    "prepush": "tsx ./scripts/prepush.ts",
    "preview:examples": "npm run build:examples && npm run preview --workspace=@flighthq/examples",
    "preview:functional": "npm run build:functional && npm run preview --workspace=tools/functional",
    "reachability": "tsx ./scripts/reachability.ts",
    "reachability:baseline": "tsx ./scripts/reachability.ts --update",
    "reachability:check": "tsx ./scripts/reachability.ts --check",
    "reachability:json": "tsx ./scripts/reachability.ts --json",
    "reachability:registrars:baseline": "tsx ./scripts/reachability.ts --update-registrars",
    "reachability:runtime": "tsx ./scripts/registrar-runtime.ts",
    "reachability:runtime:check": "tsx ./scripts/registrar-runtime.ts --check",
    "reachability:runtime:json": "tsx ./scripts/registrar-runtime.ts --json",
    "reference-image:calibrate": "tsx ./scripts/reference-image-calibrate.ts",
    "reference-image:check": "tsx ./scripts/reference-image-check.ts check",
    "reference-image:commission": "tsx ./scripts/reference-image-commission-batch.ts report",
    "reference-image:commission:write": "tsx ./scripts/reference-image-commission-batch.ts write",
    "reference-image:fetch": "tsx ./scripts/reference-image-check.ts fetch",
    "reference-image:scope": "tsx ./scripts/reference-image-check.ts scope",
    "release": "tsx ./scripts/publish-packages.ts",
    "review": "npm run dev:review",
    "review:examples": "cross-env VITE_REVIEW_TOOL=examples npm run dev --workspace=tools/review",
    "review:examples:fresh": "npm run build:examples && npm run capture:examples && cross-env VITE_REVIEW_TOOL=examples npm run dev --workspace=tools/review",
    "review:functional": "cross-env VITE_REVIEW_TOOL=functional npm run dev --workspace=tools/review",
    "review:functional:fresh": "npm run build:functional && npm run capture:functional && cross-env VITE_REVIEW_TOOL=functional npm run dev --workspace=tools/review",
    "review:snapshot": "tsx ./scripts/review-snapshot.ts",
    "sbx:whitelist": "sbx policy allow network cdn.playwright.dev,playwright.download.prss.microsoft.com,github.com,objects.githubusercontent.com,release-assets.githubusercontent.com,static.crates.io,crates.io",
    "shader-vertical-origin": "tsx ./scripts/shader-vertical-origin.ts",
    "size": "tsx ./scripts/size.ts",
    "size:baseline": "cross-env UPDATE_BASELINE=1 tsx ./scripts/size.ts",
    "size:minified": "tsx ./scripts/size-minified.ts",
    "size:minified:baseline": "cross-env UPDATE_BASELINE=1 tsx ./scripts/size-minified.ts",
    "start:electron-harness": "npm run start --workspace=@flighthq/examples-electron",
    "support": "tsx ./scripts/support.ts",
    "support:check": "tsx ./scripts/support.ts --check",
    "test": "tsx ./scripts/test.ts",
    "test:baseline": "npm run test:regression:baseline",
    "test:browser": "tsx ./packages/tool-capture/src/bin.ts batch",
    "test:coverage": "vitest run --coverage",
    "test:examples": "tsx ./packages/tool-capture/src/bin.ts batch --only=examples",
    "test:examples:baseline": "npm run test:examples:regression:baseline",
    "test:examples:parity": "tsx ./packages/tool-capture/src/bin.ts validate --tool=examples --frames=30 --renderer=dom,canvas,webgl,webgpu --no-regression",
    "test:examples:regression": "tsx ./packages/tool-capture/src/bin.ts validate --tool=examples --frames=30 --renderer=dom,canvas,webgl,webgpu --no-parity",
    "test:examples:regression:baseline": "tsx ./packages/tool-capture/src/bin.ts validate --tool=examples --frames=30 --renderer=dom,canvas,webgl,webgpu --update-fingerprints",
    "test:examples:smoke": "tsx ./packages/tool-capture/src/bin.ts capture --tool=examples --frames=30 --fail-on-error",
    "test:functional": "tsx ./packages/tool-capture/src/bin.ts batch --only=functional",
    "test:functional:baseline": "npm run test:functional:regression:baseline",
    "test:functional:parity": "tsx ./packages/tool-capture/src/bin.ts validate --tool=functional --renderer=dom,canvas,webgl,webgpu --no-regression",
    "test:functional:parity:confounds": "tsx ./scripts/functional-parity-confounds.ts",
    "test:functional:parity:orientation": "tsx ./scripts/functional-parity-orientation.ts",
    "test:functional:regression": "tsx ./packages/tool-capture/src/bin.ts validate --tool=functional --renderer=dom,canvas,webgl,webgpu --no-parity",
    "test:functional:regression:baseline": "tsx ./packages/tool-capture/src/bin.ts validate --tool=functional --renderer=dom,canvas,webgl,webgpu --update-fingerprints",
    "test:functional:smoke": "tsx ./packages/tool-capture/src/bin.ts capture --tool=functional --frames=1 --fail-on-error",
    "test:parity": "npm run test:functional:parity && npm run test:examples:parity",
    "test:regression": "npm run test:functional:regression && npm run test:examples:regression",
    "test:regression:baseline": "npm run test:functional:regression:baseline && npm run test:examples:regression:baseline",
    "test:smoke": "npm run test:functional:smoke && npm run test:examples:smoke",
    "test:unit": "tsx ./scripts/test-packages.ts",
    "type-home": "tsx ./scripts/type-home-progress.ts",
    "type-home:check": "tsx ./scripts/type-home-progress.ts --gate",
    "typecheck": "tsx ./scripts/typecheck.ts",
    "unchecked": "tsx ./scripts/unchecked.ts",
    "unchecked:json": "tsx ./scripts/unchecked.ts --json",
    "untested": "tsx ./scripts/untested.ts",
    "verify:backgrounds": "tsx ./scripts/verify-expected-image-backgrounds.ts",
    "version:packages": "tsx ./scripts/version-packages.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jsdom": "30.0.0",
    "@types/stats.js": "^0.17.4",
    "@vitest/coverage-v8": "^4.0.17",
    "@webgpu/types": "^0.1.70",
    "chokidar": "^3.6.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "oxc-parser": "0.138.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "picocolors": "^1.1.1",
    "stats.js": "^0.17.0",
    "terser": "^5.46.0",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17",
    "vitest-webgl-canvas-mock": "^1.1.0"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": "tsx ./scripts/order.ts --fix",
    "**/*.{ts,tsx}": [
      "oxlint --fix --max-warnings=0 --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "**/*.{json,md}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "vite": "^7.3.1"
  }
}
